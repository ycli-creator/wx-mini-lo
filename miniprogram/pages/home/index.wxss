.home-screen { padding-left: 24rpx; padding-right: 24rpx; }
.memory-banner { position: relative; min-height: 430rpx; margin-bottom: 26rpx; overflow: hidden; color: #fff; background: #7f4d4d; border-radius: 40rpx; box-shadow: 0 18rpx 44rpx rgba(78, 48, 39, .16); }
.memory-banner.personal { background: #7a6260; }
.banner-image, .banner-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.banner-shade { background: linear-gradient(180deg, rgba(31, 22, 21, .08), rgba(31, 22, 21, .76)); }
.banner-content { position: absolute; left: 34rpx; right: 34rpx; bottom: 34rpx; }
.banner-space { display: block; margin-bottom: 12rpx; color: rgba(255,255,255,.82); font-size: 23rpx; }
.banner-title { display: block; max-width: 500rpx; font-size: 46rpx; font-weight: 700; line-height: 60rpx; }
.banner-copy { display: block; margin-top: 10rpx; color: rgba(255,255,255,.82); font-size: 24rpx; line-height: 38rpx; }
.banner-stat { position: absolute; top: 28rpx; right: 28rpx; min-width: 116rpx; padding: 14rpx 18rpx; text-align: right; background: rgba(31,22,21,.4); border-radius: 22rpx; }
.banner-stat text { display: block; }
.banner-stat text:first-child { font-size: 34rpx; font-weight: 700; }
.banner-stat text:last-child { color: rgba(255,255,255,.76); font-size: 19rpx; }
.home-tabs { margin-bottom: 20rpx; display: flex; gap: 30rpx; border-bottom: 2rpx solid var(--lp-border); }
.home-tab { position: relative; padding: 18rpx 4rpx 22rpx; color: var(--lp-text-secondary); font-size: 28rpx; }
.home-tab.active { color: var(--lp-text-primary); font-weight: 700; }
.home-tab.active::after { content: ''; position: absolute; left: 0; right: 0; bottom: -2rpx; height: 5rpx; background: var(--lp-brand); border-radius: 999rpx; }
.home-panel { min-height: 320rpx; }
.heat-strip, .action-notice { min-height: 112rpx; margin-bottom: 20rpx; padding: 22rpx 26rpx; display: flex; align-items: center; gap: 18rpx; background: var(--lp-brand-soft); border-radius: 28rpx; }
.heat-strip > view:first-child, .action-notice > view { min-width: 0; flex: 1; }
.strip-title { display: block; font-size: 28rpx; font-weight: 700; }
.strip-copy { display: block; color: var(--lp-text-secondary); font-size: 22rpx; }
.heat-number { color: var(--lp-brand-text); font-size: 34rpx; font-weight: 700; }
.action-notice { color: var(--lp-blue); background: var(--lp-blue-bg); }
.tool-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.tool-item { min-height: 190rpx; padding: 26rpx; background: #fff; border: 2rpx solid var(--lp-border); border-radius: 28rpx; }
.tool-icon { width: 66rpx; height: 66rpx; margin-bottom: 20rpx; display: flex; align-items: center; justify-content: center; color: var(--lp-brand-text); background: var(--lp-brand-soft); border-radius: 20rpx; }
.tool-title { display: block; font-size: 29rpx; font-weight: 700; }
.tool-copy { display: block; margin-top: 5rpx; color: var(--lp-text-secondary); font-size: 21rpx; line-height: 32rpx; }
