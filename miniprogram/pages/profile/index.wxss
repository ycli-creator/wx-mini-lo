.profile-cover{height:220rpx;margin:0 -30rpx;background:linear-gradient(135deg,#ffe8df,#fff4e9 58%,#f7dfda);position:relative}.cover-actions{position:absolute;right:28rpx;top:24rpx;padding:12rpx 22rpx;color:var(--lp-text-primary);background:rgba(255,255,255,.82);border-radius:999rpx;font-size:24rpx}.identity-row{margin-top:-52rpx;display:flex;align-items:flex-end;gap:22rpx;position:relative}.profile-avatar{width:126rpx;height:126rpx;flex:none;border:8rpx solid var(--lp-bg-canvas);border-radius:50%;background:#fff}.profile-avatar.empty{display:flex;align-items:center;justify-content:center;color:var(--lp-brand-text);background:var(--lp-brand-soft)}.identity-copy{min-width:0;flex:1;padding-bottom:8rpx}.profile-name,.profile-region{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.profile-name{font-size:40rpx;font-weight:600;line-height:56rpx}.profile-region{color:var(--lp-text-secondary);font-size:24rpx}.identity-code,.partner-row{margin-top:20rpx;display:flex;align-items:center;justify-content:space-between;gap:20rpx;color:var(--lp-text-secondary);font-size:24rpx}.copy-label,.partner-name{color:var(--lp-brand-text)}.partner-row{padding:20rpx 24rpx;background:var(--lp-brand-soft);border-radius:24rpx}.partner-label{color:var(--lp-text-primary);font-weight:600}.stat-row{margin:32rpx 0 28rpx;display:grid;grid-template-columns:repeat(4,1fr)}.stat-row view{text-align:center}.stat-value,.stat-label{display:block}.stat-value{font-size:32rpx;font-weight:600}.stat-label{margin-top:4rpx;color:var(--lp-text-secondary);font-size:22rpx}.profile-tabs{margin-bottom:28rpx;border-bottom:2rpx solid rgba(238,223,216,.7);white-space:nowrap}.tabs-inner{display:flex}.tab{min-width:120rpx;padding:18rpx 16rpx;color:var(--lp-text-secondary);text-align:center;position:relative}.tab.active{color:var(--lp-text-primary)}.tab.active::after{content:'';position:absolute;left:34rpx;right:34rpx;bottom:0;height:5rpx;background:var(--lp-brand);border-radius:999rpx}.achievement-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18rpx}.achievement{padding:24rpx 12rpx;text-align:center;opacity:.46}.achievement.unlocked{opacity:1}.badge{width:74rpx;height:74rpx;margin:0 auto 14rpx;display:flex;align-items:center;justify-content:center;color:var(--lp-text-secondary);background:var(--lp-disabled);border-radius:50%;font-size:22rpx;font-weight:600}.unlocked .badge{color:#fff;background:var(--lp-brand)}.achievement-title,.achievement-copy{display:block}.achievement-title{font-size:24rpx;font-weight:600}.achievement-copy{margin-top:4rpx;color:var(--lp-text-secondary);font-size:20rpx}.data-list{background:#fff;border:2rpx solid var(--lp-border);border-radius:30rpx;overflow:hidden}.data-row{min-height:94rpx;padding:20rpx 26rpx;display:flex;align-items:center;justify-content:space-between}.data-row+.data-row{border-top:2rpx solid rgba(238,223,216,.72)}
.profile-cover{overflow:hidden}.cover-image{width:100%;height:100%}
