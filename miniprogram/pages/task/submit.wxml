<view class="screen">
  <lp-header title="提交任务" subtitle="完成后由对方审批，审批通过才会获得积分" />
  <lp-page-state wx:if="{{loading || loadError}}" loading="{{loading}}" loading-text="正在读取任务" error-text="任务暂时无法读取，请重新加载。" bind:retry="refresh" />
  <block wx:else>
  <lp-task-card status="{{task.status}}" title="{{task.title}}" subtitle="{{task.planType === 'daily' ? '每日计划 · ' : task.planType === 'weekly' ? '每周计划 · ' : '长期计划 · '}}{{task.cycleLabel}}" task-description="{{task.description}}" points="{{task.points}}" disabled />
  <view wx:if="{{task.status === 'rejected'}}" class="notice-card warning"><text class="notice-title">任务已被驳回</text><text class="notice-copy">{{task.rejectionReason || '请补充完成说明后重新提交。'}}</text></view>
  <view class="form-card">
    <text class="field-label">完成说明</text>
    <textarea class="text-area" value="{{note}}" maxlength="300" bind:input="handleNote" />
  </view>
  <lp-button label="提交给对方审批" disabled="{{!note}}" loading="{{busy}}" bind:tap="submit" />
  <lp-button label="返回首页" variant="text" bind:tap="goHome" />
  </block>
</view>
