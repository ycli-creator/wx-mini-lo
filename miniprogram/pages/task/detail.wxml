<view class="screen task-detail-screen">
  <lp-header title="{{task.kind === 'project' ? '大任务' : '任务详情'}}" subtitle="{{task.kind === 'project' ? '环节可以独立完成，不需要严格按顺序' : '查看要求、进度与完成记录'}}" />
  <lp-page-state wx:if="{{loading || loadError}}" loading="{{loading}}" loading-text="正在读取任务详情" error-text="任务详情暂时无法读取，请重新加载。" bind:retry="refresh" />
  <block wx:else>
    <view class="task-hero {{task.kind === 'project' ? 'project' : ''}}"><view class="task-hero-top"><text class="task-kind">{{task.kind === 'project' ? '共同大任务' : task.kind === 'recurring' ? '重复任务' : '单次任务'}}</text><text class="status-tag {{task.status === 'done' ? 'status-done' : task.status === 'pending' ? 'status-pending' : 'status-todo'}}">{{task.status === 'done' ? '已完成' : task.status === 'pending' ? '待审批' : '进行中'}}</text></view><text class="task-title">{{task.title}}</text><text class="task-description">{{task.description}}</text><view class="task-reward"><text>总奖励</text><text class="reward-number">{{task.points}} 积分</text></view><view class="detail-progress"><view class="detail-progress-bar" style="width: {{task.progressPercent}}%;"></view></view></view>
    <lp-cue-button wx:if="{{!task.assigneeIsSelf || task.kind === 'project'}}" type="custom_task" title="{{task.title}}" description="{{task.description}}" resource-type="task" resource-id="{{task.id}}" action-path="/pages/task/detail?id={{task.id}}" action-text="查看进度" label="@TA 查看当前进度" />
    <block wx:if="{{task.kind === 'project'}}">
      <view class="section-heading"><text class="section-title">任务环节</text><text class="section-caption">完成一个发放 10%</text></view>
      <view class="project-step-list"><view wx:for="{{task.projectSteps}}" wx:key="id" class="project-step {{item.status === 'done' ? 'done' : ''}}" data-id="{{item.id}}" bind:tap="selectStep"><view class="step-status"><t-icon name="{{item.status === 'done' ? 'check-circle-filled' : 'circle'}}" size="34rpx" /></view><view class="cell-copy"><text class="cell-title">{{item.title}}</text><text class="cell-subtitle">{{item.assigneeIsSelf ? '由我完成' : '由 TA 完成'}} · {{item.completionRequirement === 'image' ? '需上传图片' : item.completionRequirement === 'note' ? '需填写说明' : '直接完成'}} · +{{item.rewardPoints}}</text></view><text wx:if="{{item.status !== 'done'}}" class="chevron">›</text></view></view>
      <view wx:if="{{activeStepId}}" class="step-completion"><view class="section-heading"><text class="section-title">完成这个环节</text><text class="remove-step" bind:tap="closeStep">收起</text></view><textarea class="text-area" maxlength="300" placeholder="补充完成说明（按环节要求填写）" value="{{note}}" bind:input="handleNote"/><view wx:if="{{images.length}}" class="evidence-grid"><image wx:for="{{images}}" wx:key="localPath" src="{{item.localPath}}" mode="aspectFill"/></view><view class="add-evidence" bind:tap="chooseImage">添加完成图片（{{images.length}} / 3）</view><lp-button label="完成并领取 10% 奖励" loading="{{busy}}" bind:tap="completeStep" /></view>
      <lp-button wx:if="{{allStepsDone && !task.projectFinalized}}" label="完成整个大任务并领取剩余积分" loading="{{busy}}" bind:tap="completeProject" />
      <view wx:if="{{task.projectFinalized}}" class="notice-card success"><text class="notice-title">共同计划已经完成</text><text class="notice-copy">所有节点与剩余积分都已结算。</text></view>
    </block>
    <block wx:else><view class="info-card"><view class="data-row"><text>负责人</text><text>{{task.assigneeIsSelf ? '我' : 'TA'}}</text></view><view class="data-row"><text>完成条件</text><text>{{task.completionRequirement === 'image' ? '上传图片' : task.completionRequirement === 'note' ? '填写说明' : '直接完成'}}</text></view><view class="data-row"><text>计划周期</text><text>{{task.planType === 'daily' ? '每日' : task.planType === 'weekly' ? '每周' : '单次'}}</text></view></view><lp-button label="{{task.status === 'done' ? '查看完成结果' : task.status === 'pending' ? '查看审批进度' : task.assigneeIsSelf ? '去完成任务' : '等待 TA 完成'}}" variant="{{task.assigneeIsSelf || task.status === 'pending' || task.status === 'done' ? 'primary' : 'soft'}}" bind:tap="openTaskAction" /></block>
  </block>
</view>
