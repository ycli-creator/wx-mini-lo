.task-hero { margin-bottom: 26rpx; padding: 36rpx; color: var(--lp-text-primary); background: #fff; border: 2rpx solid var(--lp-border); border-radius: 38rpx; box-shadow: 0 10rpx 34rpx rgba(78, 48, 39, .07); }
.task-hero.project { background: var(--lp-brand-soft); border-color: transparent; }
.task-hero-top, .task-reward { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.task-kind { color: var(--lp-brand-text); font-size: 23rpx; font-weight: 700; }
.task-title { display: block; margin-top: 24rpx; font-size: 42rpx; font-weight: 700; line-height: 56rpx; }
.task-description { display: block; margin: 12rpx 0 28rpx; color: var(--lp-text-secondary); font-size: 27rpx; line-height: 44rpx; }
.task-reward { font-size: 24rpx; }
.reward-number { color: var(--lp-brand-text); font-size: 30rpx; font-weight: 700; }
.detail-progress { height: 12rpx; margin-top: 24rpx; overflow: hidden; background: #efdcd8; border-radius: 999rpx; }
.detail-progress-bar { height: 100%; background: var(--lp-brand); border-radius: inherit; }
.project-step-list { margin-bottom: 28rpx; display: flex; flex-direction: column; gap: 14rpx; }
.project-step { min-height: 128rpx; padding: 20rpx 24rpx; display: flex; align-items: center; gap: 18rpx; background: #fff; border: 2rpx solid var(--lp-border); border-radius: 28rpx; }
.project-step.done { opacity: .7; }
.step-status { color: var(--lp-brand-text); }
.step-completion { margin-bottom: 28rpx; padding: 28rpx; background: #fff; border: 2rpx solid var(--lp-border); border-radius: 32rpx; }
.evidence-grid { margin: 16rpx 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.evidence-grid image { width: 100%; height: 160rpx; border-radius: 20rpx; }
.add-evidence { min-height: 76rpx; margin: 16rpx 0 22rpx; display: flex; align-items: center; justify-content: center; color: var(--lp-brand-text); background: var(--lp-brand-soft); border-radius: 22rpx; }
.data-row { min-height: 74rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; color: var(--lp-text-secondary); }
.data-row text:last-child { color: var(--lp-text-primary); font-weight: 600; }
.cue-block{margin-bottom:28rpx}
