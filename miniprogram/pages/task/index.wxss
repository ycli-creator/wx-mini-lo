.task-screen{padding-left:24rpx;padding-right:24rpx}.task-main-segment{margin-bottom:24rpx}.creator-card{padding:30rpx 26rpx;border-radius:34rpx}.creator-heading{margin-bottom:20rpx;display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.creator-copy{display:block;margin-top:4rpx;color:var(--lp-text-secondary);font-size:22rpx}.template-selected{padding:6rpx 14rpx;color:var(--lp-brand-text);background:var(--lp-brand-soft);border-radius:999rpx;font-size:20rpx;white-space:nowrap}.template-scroll{width:100%;margin:0 0 26rpx;white-space:nowrap}.template-row{display:inline-flex;gap:14rpx;padding:2rpx}.template-card{width:190rpx;min-height:156rpx;padding:20rpx;display:inline-flex;flex-direction:column;justify-content:space-between;white-space:normal;background:var(--lp-bg-canvas);border:2rpx solid var(--lp-border);border-radius:24rpx}.template-card.selected{background:var(--lp-brand-soft);border-color:var(--lp-brand)}.template-icon{font-size:34rpx;line-height:42rpx}.template-title{margin:8rpx 0 4rpx;color:var(--lp-text-primary);font-size:24rpx;font-weight:700;line-height:34rpx}.template-meta{color:var(--lp-text-secondary);font-size:20rpx}.create-field{position:relative}.input-suffix{position:absolute;right:20rpx;bottom:30rpx;color:var(--lp-text-secondary);font-size:22rpx}.todo-summary{min-height:116rpx;margin-bottom:20rpx;padding:20rpx 26rpx;display:flex;align-items:center;gap:34rpx;color:#fff;background:linear-gradient(135deg,#ec5965,#f57c74);border-radius:30rpx;box-shadow:0 12rpx 28rpx rgba(232,74,87,.16)}.todo-summary>view{min-width:74rpx}.summary-value,.summary-label{display:block}.summary-value{font-size:34rpx;font-weight:800}.summary-label{color:rgba(255,255,255,.78);font-size:20rpx}.summary-note{margin-left:auto;color:rgba(255,255,255,.86);font-size:22rpx}.task-sections{display:flex;flex-direction:column;gap:14rpx}.task-section{overflow:hidden;background:#fff;border:2rpx solid var(--lp-border);border-radius:28rpx}.task-section.today{border-color