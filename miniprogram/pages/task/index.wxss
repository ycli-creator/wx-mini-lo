-radius:30rpx}
.assignee-three{grid-template-columns:repeat(3,1fr)}.field-note{display:block;margin:-8rpx 0 18rpx;color:var(--lp-text-secondary);font-size:21rpx;line-height:34rpx}.todo-row.both-task{min-height:142rpx}.dual-mini-progress{height:10rpx;margin-top:10rpx;display:grid;grid-template-columns:1fr 1fr;gap:4rpx;overflow:hidden;border-radius:999rpx}.dual-half{background:#e8e8eb}.dual-half.self.filled{background:#6aa6e8}.dual-half.partner.filled{background:#f18aa8}.dual-mini-labels{margin-top:5rpx;display:flex;justify-content:space-between;color:var(--lp-text-secondary);font-size:18rpx}.status-partial{color:#4d84c6;background:#eaf2ff}
