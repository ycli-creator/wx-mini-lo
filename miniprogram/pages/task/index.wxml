<view class="screen with-tabbar has-floating-action">
  <lp-header title="{{viewMode === 'tasks' ? '我们的任务' : '奖励商店'}}" subtitle="{{viewMode === 'tasks' ? '把想一起完成的事，一件件变成积分' : '用共同努力兑换只属于你们的期待'}}" />
  <view class="segment"><view class="segment-item {{viewMode === 'tasks' ? 'active' : ''}}" data-view="tasks" bind:tap="switchView">任务</view><view class="segment-item {{viewMode === 'shop' ? 'active' : ''}}" data-view="shop" bind:tap="switchView">奖励商店</view></view>
  <lp-page-state wx:if="{{loading || loadError}}" loading="{{loading}}" loading-text="正在同步任务与商店" error-text="任务和商店暂时没有同步成功，请重新加载。" bind:retry="refresh" />
  <block wx:else>
    <block wx:if="{{viewMode === 'tasks'}}">
      <scroll-view scroll-x enhanced class="plan-filter-scroll" show-scrollbar="{{false}}"><view class="plan-filters"><view class="plan-filter {{taskFilter === 'daily' ? 'active' : ''}}" data-filter="daily" bind:tap="selectTaskFilter">今日</view><view class="plan-filter {{taskFilter === 'weekly' ? 'active' : ''}}" data-filter="weekly" bind:tap="selectTaskFilter">本周</view><view class="plan-filter {{taskFilter === 'long_term' ? 'active' : ''}}" data-filter="long_term" bind:tap="selectTaskFilter">长期</view><view class="plan-filter {{taskFilter === 'pending' ? 'active' : ''}}" data-filter="pending" bind:tap="selectTaskFilter">待审批</view></view></scroll-view>
      <view wx:if="{{createOpen}}" class="create-panel">
        <view class="create-field"><text class="field-hint">任务名称</text><input class="text-input" maxlength="60" value="{{title}}" bind:input="handleTitle" /></view>
        <view class="create-field"><text class="field-hint">任务说明</text><input class="text-input" maxlength="200" value="{{description}}" bind:input="handleDescription" /></view>
        <view class="create-field"><text class="field-hint">完成积分</text><input class="text-input" type="number" value="{{points}}" bind:input="handlePoints" /></view>
        <text class="field-hint section-gap">计划周期</text>
        <view class="segment plan-type-segment"><view class="segment-item {{planType === 'daily' ? 'active' : ''}}" data-plan="daily" bind:tap="selectPlanType">每日</view><view class="segment-item {{planType === 'weekly' ? 'active' : ''}}" data-plan="weekly" bind:tap="selectPlanType">每周</view><view class="segment-item {{planType === 'long_term' ? 'active' : ''}}" data-plan="long_term" bind:tap="selectPlanType">长期</view></view>
        <text class="field-hint section-gap">积分归属</text>
        <view class="segment"><view class="segment-item {{taskType === 'shared' ? 'active' : ''}}" data-type="shared" bind:tap="selectTaskType">共同积分</view><view class="segment-item {{taskType === 'personal' ? 'active' : ''}}" data-type="personal" bind:tap="selectTaskType">个人积分</view></view>
        <text class="field-hint section-gap">任务执行人</text>
        <view class="segment"><view class="segment-item {{assignee === 'self' ? 'active' : ''}}" data-assignee="self" bind:tap="selectAssignee">我来完成</view><view class="segment-item {{assignee === 'partner' ? 'active' : ''}}" data-assignee="partner" bind:tap="selectAssignee">对方完成</view></view>
        <lp-button label="创建任务" disabled="{{!title || !points}}" loading="{{busy}}" bind:tap="createTask" />
      </view>
      <view class="points-card"><view class="points-column"><text class="points-label">进行中</text><text class="points-value">{{activeCount}}</text></view><view class="points-column"><text class="points-label">待审批</text><text class="points-value">{{pendingCount}}</text></view></view>
      <view class="section-heading"><text class="section-title">{{taskFilter === 'daily' ? '今日计划' : taskFilter === 'weekly' ? '本周计划' : taskFilter === 'long_term' ? '长期计划' : '待审批计划'}}</text><text class="section-caption">{{tasks.length}} 项任务</text></view>
      <view wx:if="{{tasks.length}}" class="list"><view wx:for="{{tasks}}" wx:key="id" class="list-cell" data-id="{{item.id}}" hover-class="pressed" bind:tap="openTask"><view class="cell-icon"><t-icon name="task" size="30rpx" /></view><view class="cell-copy"><text class="cell-title">{{item.title}}</text><text class="cell-subtitle">{{item.planLabel}} · {{item.typeLabel}} · {{item.actionLabel}} · +{{item.points}}</text></view><text class="status-tag {{item.statusClass}}">{{item.statusLabel}}</text></view></view>
      <view wx:else class="empty-state"><text class="empty-title">还没有任务</text><text class="empty-copy">点下方“新建任务”，添加第一件想一起完成的事。</text></view>
    </block>
    <block wx:else>
      <view wx:if="{{createOpen}}" class="create-panel">
        <view class="create-field"><text class="field-hint">奖励名称</text><input class="text-input" value="{{rewardName}}" bind:input="handleRewardName" /></view>
        <view class="create-field"><text class="field-hint">简短说明</text><input class="text-input" value="{{rewardDescription}}" bind:input="handleRewardDescription" /></view>
        <view class="create-field"><text class="field-hint">所需积分</text><input class="text-input" type="number" value="{{rewardCost}}" bind:input="handleRewardCost" /></view>
        <view class="create-field"><text class="field-hint">有效期</text><input class="text-input" maxlength="60" value="{{rewardExpiry}}" bind:input="handleRewardExpiry" /></view>
        <view class="create-field"><text class="field-hint">使用条件</text><input class="text-input" maxlength="120" value="{{rewardCondition}}" bind:input="handleRewardCondition" /></view>
        <view class="segment"><view class="segment-item {{rewardPointsType === 'shared' ? 'active' : ''}}" data-type="shared" bind:tap="selectRewardPointsType">共同积分</view><view class="segment-item {{rewardPointsType === 'personal' ? 'active' : ''}}" data-type="personal" bind:tap="selectRewardPointsType">个人积分</view></view>
        <view class="switch-row"><view><text class="cell-title">兑换前需要对方同意</text><text class="cell-subtitle">开启后，积分会在对方审批通过时扣除</text></view><switch color="#f65f6b" checked="{{rewardApprovalRequired}}" bind:change="handleRewardApproval" /></view>
        <lp-button label="创建奖励" disabled="{{!rewardName || !rewardCost}}" loading="{{busy}}" bind:tap="createReward" />
      </view>
      <view class="notice-card brand"><text class="notice-title">共同积分 {{state.sharedPoints}}</text><text class="notice-copy">奖励可指定使用个人积分或共同积分。</text></view>
      <view class="list"><view wx:for="{{rewards}}" wx:key="id" class="reward-card" data-id="{{item.id}}" hover-class="pressed" bind:tap="openReward"><view class="reward-icon"><t-icon name="gift" size="42rpx" /></view><view class="cell-copy"><text class="cell-title">{{item.name}}</text><text class="cell-subtitle">{{item.description}}</text></view><text class="status-tag {{item.statusClass}}">{{item.statusLabel}}</text><view class="reward-cost"><t-icon name="money" size="30rpx" /><text>{{item.cost}} {{item.pointsLabel}}积分</text></view></view></view>
      <view wx:if="{{!rewards.length}}" class="empty-state"><text class="empty-title">还没有奖励</text><text class="empty-copy">点下方“新建奖励”，添加第一份只属于你们的期待。</text></view>
    </block>
    <view class="floating-create-action {{createOpen ? 'is-open' : ''}}" hover-class="floating-create-action--pressed" bind:tap="toggleCreate"><text class="floating-create-icon">{{createOpen ? '×' : '＋'}}</text><text>{{createOpen ? '收起' : viewMode === 'tasks' ? '新建任务' : '新建奖励'}}</text></view>
  </block>
</view>
