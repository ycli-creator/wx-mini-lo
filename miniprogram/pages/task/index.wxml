<view class="screen with-tabbar has-floating-action">
  <lp-header title="{{viewMode === 'tasks' ? (state.activeSpaceType === 'couple' ? '我们的任务' : '我的任务') : '奖励商店'}}" subtitle="{{state.activeSpaceType === 'couple' ? '一起规划，也保留各自负责的节奏' : '只记录属于自己的进度与奖励'}}" />
  <view class="segment"><view class="segment-item {{viewMode === 'tasks' ? 'active' : ''}}" data-view="tasks" bind:tap="switchView">任务</view><view class="segment-item {{viewMode === 'shop' ? 'active' : ''}}" data-view="shop" bind:tap="switchView">奖励商店</view></view>
  <lp-page-state wx:if="{{loading || loadError}}" loading="{{loading}}" loading-text="正在同步任务与商店" error-text="任务和商店暂时没有同步成功，请重新加载。" bind:retry="refresh" />
  <block wx:else>
    <block wx:if="{{viewMode === 'tasks'}}">
      <scroll-view scroll-x enhanced class="plan-filter-scroll" show-scrollbar="{{false}}"><view class="plan-filters"><view class="plan-filter {{taskFilter === 'active' ? 'active' : ''}}" data-filter="active" bind:tap="selectTaskFilter">进行中</view><view class="plan-filter {{taskFilter === 'recurring' ? 'active' : ''}}" data-filter="recurring" bind:tap="selectTaskFilter">重复任务</view><view class="plan-filter {{taskFilter === 'project' ? 'active' : ''}}" data-filter="project" bind:tap="selectTaskFilter">大任务</view><view class="plan-filter {{taskFilter === 'done' ? 'active' : ''}}" data-filter="done" bind:tap="selectTaskFilter">已完成</view><view class="plan-filter {{taskFilter === 'pending' ? 'active' : ''}}" data-filter="pending" bind:tap="selectTaskFilter">待审批</view></view></scroll-view>
      <view wx:if="{{createOpen}}" class="create-panel">
        <text class="field-hint">任务类型</text>
        <view class="segment task-kind-segment"><view class="segment-item {{taskKind === 'one_time' ? 'active' : ''}}" data-kind="one_time" bind:tap="selectTaskKind">单次</view><view class="segment-item {{taskKind === 'recurring' ? 'active' : ''}}" data-kind="recurring" bind:tap="selectTaskKind">重复</view><view class="segment-item {{taskKind === 'project' ? 'active' : ''}} {{state.activeSpaceType !== 'couple' ? 'disabled' : ''}}" data-kind="project" bind:tap="selectTaskKind">大任务</view></view>
        <view class="create-field"><text class="field-hint">任务名称</text><input class="text-input" maxlength="60" value="{{title}}" bind:input="handleTitle" /></view>
        <view class="create-field"><text class="field-hint">任务说明</text><input class="text-input" maxlength="200" value="{{description}}" bind:input="handleDescription" /></view>
        <view class="create-field"><text class="field-hint">总奖励积分</text><input class="text-input" type="number" value="{{points}}" bind:input="handlePoints" /></view>
        <block wx:if="{{taskKind === 'recurring'}}"><text class="field-hint section-gap">重复周期</text><view class="segment"><view class="segment-item {{planType === 'daily' ? 'active' : ''}}" data-plan="daily" bind:tap="selectPlanType">每日</view><view class="segment-item {{planType === 'weekly' ? 'active' : ''}}" data-plan="weekly" bind:tap="selectPlanType">每周</view></view></block>
        <block wx:if="{{taskKind !== 'project'}}">
          <text class="field-hint section-gap">完成条件</text>
          <view class="choice-wrap"><view class="choice-chip {{completionRequirement === 'direct' ? 'active' : ''}}" data-requirement="direct" bind:tap="selectCompletionRequirement">直接完成</view><view class="choice-chip {{completionRequirement === 'note' ? 'active' : ''}}" data-requirement="note" bind:tap="selectCompletionRequirement">填写说明</view><view class="choice-chip {{completionRequirement === 'image' ? 'active' : ''}}" data-requirement="image" bind:tap="selectCompletionRequirement">上传图片</view></view>
          <text class="field-hint section-gap">任务执行人</text>
          <view wx:if="{{state.activeSpaceType === 'couple'}}" class="segment"><view class="segment-item {{assignee === 'self' ? 'active' : ''}}" data-assignee="self" bind:tap="selectAssignee">我来完成</view><view class="segment-item {{assignee === 'partner' ? 'active' : ''}}" data-assignee="partner" bind:tap="selectAssignee">TA 来完成</view></view>
        </block>
        <block wx:else>
          <view class="project-explain"><text class="cell-title">大任务会分段奖励</text><text class="cell-subtitle">每个环节完成发放总积分的 10%，全部完成后一次发放剩余积分。</text></view>
          <view wx:for="{{projectSteps}}" wx:key="index" class="project-step-editor">
            <view class="section-heading"><text class="section-title">环节 {{index + 1}}</text><text class="remove-step" data-index="{{index}}" bind:tap="removeProjectStep">移除</text></view>
            <input class="text-input step-title-input" maxlength="60" placeholder="例如：购买车票" value="{{item.title}}" data-index="{{index}}" bind:input="handleProjectStepTitle" />
            <view class="segment compact"><view class="segment-item {{item.assignee === 'self' ? 'active' : ''}}" data-index="{{index}}" data-assignee="self" bind:tap="selectProjectStepAssignee">我完成</view><view class="segment-item {{item.assignee === 'partner' ? 'active' : ''}}" data-index="{{index}}" data-assignee="partner" bind:tap="selectProjectStepAssignee">TA 完成</view></view>
            <view class="choice-wrap compact"><view class="choice-chip {{item.completionRequirement === 'direct' ? 'active' : ''}}" data-index="{{index}}" data-requirement="direct" bind:tap="selectProjectStepRequirement">直接完成</view><view class="choice-chip {{item.completionRequirement === 'note' ? 'active' : ''}}" data-index="{{index}}" data-requirement="note" bind:tap="selectProjectStepRequirement">说明</view><view class="choice-chip {{item.completionRequirement === 'image' ? 'active' : ''}}" data-index="{{index}}" data-requirement="image" bind:tap="selectProjectStepRequirement">图片</view></view>
          </view>
          <view class="add-step" bind:tap="addProjectStep">添加环节（{{projectSteps.length}} / 8）</view>
        </block>
        <lp-button label="创建{{taskKind === 'project' ? '大任务' : '任务'}}" disabled="{{!title || !points}}" loading="{{busy}}" bind:tap="createTask" />
      </view>
      <view class="points-card"><view class="points-column"><text class="points-label">进行中</text><text class="points-value">{{activeCount}}</text></view><view class="points-column"><text class="points-label">待处理</text><text class="points-value">{{pendingCount}}</text></view></view>
      <view wx:if="{{tasks.length}}" class="list"><view wx:for="{{tasks}}" wx:key="id" class="list-cell task-list-cell {{item.kind === 'project' ? 'project-task' : ''}}" data-id="{{item.id}}" hover-class="pressed" bind:tap="openTask"><view class="cell-icon"><t-icon name="{{item.kind === 'project' ? 'flag' : 'task'}}" size="30rpx" /></view><view class="cell-copy"><text class="cell-title">{{item.title}}</text><text class="cell-subtitle">{{item.planLabel}} · {{item.actionLabel}} · +{{item.points}}</text><view wx:if="{{item.kind === 'project'}}" class="mini-progress"><view class="mini-progress-bar" style="width: {{item.progressPercent}}%;"></view></view></view><text class="status-tag {{item.statusClass}}">{{item.statusLabel}}</text><text class="chevron">›</text></view></view>
      <view wx:else class="empty-state"><text class="empty-title">这个分类还没有任务</text><text class="empty-copy">新建一项计划，或切换到其他分类查看。</text></view>
    </block>
    <block wx:else>
      <scroll-view scroll-x class="plan-filter-scroll" show-scrollbar="{{false}}"><view class="plan-filters"><view class="plan-filter {{rewardFilter === 'all' ? 'active' : ''}}" data-filter="all" bind:tap="selectRewardFilter">全部</view><view class="plan-filter {{rewardFilter === 'available' ? 'active' : ''}}" data-filter="available" bind:tap="selectRewardFilter">可购买</view><view class="plan-filter {{rewardFilter === 'purchased' ? 'active' : ''}}" data-filter="purchased" bind:tap="selectRewardFilter">已购买</view><view class="plan-filter {{rewardFilter === 'pending' ? 'active' : ''}}" data-filter="pending" bind:tap="selectRewardFilter">待处理</view><view class="plan-filter {{rewardFilter === 'refund' ? 'active' : ''}}" data-filter="refund" bind:tap="selectRewardFilter">待退款</view></view></scroll-view>
      <view wx:if="{{createOpen}}" class="create-panel">
        <view class="create-field"><text class="field-hint">奖励名称</text><input class="text-input" value="{{rewardName}}" bind:input="handleRewardName" /></view>
        <view class="create-field"><text class="field-hint">简短说明</text><input class="text-input" value="{{rewardDescription}}" bind:input="handleRewardDescription" /></view>
        <view class="create-field"><text class="field-hint">所需积分</text><input class="text-input" type="number" value="{{rewardCost}}" bind:input="handleRewardCost" /></view>
        <view class="create-field"><text class="field-hint">有效期</text><input class="text-input" maxlength="60" value="{{rewardExpiry}}" bind:input="handleRewardExpiry" /></view>
        <view class="create-field"><text class="field-hint">使用条件</text><input class="text-input" maxlength="120" value="{{rewardCondition}}" bind:input="handleRewardCondition" /></view>
        <block wx:if="{{state.activeSpaceType === 'couple'}}"><text class="field-hint">奖励给谁</text><view class="choice-wrap"><view class="choice-chip {{rewardBeneficiaryType === 'self' ? 'active' : ''}}" data-beneficiary="self" bind:tap="selectRewardBeneficiary">给我</view><view class="choice-chip {{rewardBeneficiaryType === 'partner' ? 'active' : ''}}" data-beneficiary="partner" bind:tap="selectRewardBeneficiary">给 TA</view><view class="choice-chip {{rewardBeneficiaryType === 'couple' ? 'active' : ''}}" data-beneficiary="couple" bind:tap="selectRewardBeneficiary">两人共同</view></view></block>
        <view wx:if="{{state.activeSpaceType === 'couple'}}" class="switch-row"><view><text class="cell-title">兑换前需要对方同意</text><text class="cell-subtitle">开启后，在 TA 同意时扣除情侣积分</text></view><switch color="#f65f6b" checked="{{rewardApprovalRequired}}" bind:change="handleRewardApproval" /></view>
        <lp-button label="创建奖励" disabled="{{!rewardName || !rewardCost}}" loading="{{busy}}" bind:tap="createReward" />
      </view>
      <view class="notice-card brand"><text class="notice-title">{{state.activeSpaceType === 'couple' ? '情侣积分 ' + state.sharedPoints : '个人积分 ' + state.personalPoints}}</text><text class="notice-copy">当前商店只展示并使用这个空间的积分与奖励。</text></view>
      <view class="list"><view wx:for="{{rewards}}" wx:key="id" class="reward-card" data-id="{{item.id}}" hover-class="pressed" bind:tap="openReward"><view class="reward-icon"><t-icon name="gift" size="42rpx" /></view><view class="cell-copy"><text class="cell-title">{{item.name}}</text><text class="cell-subtitle">{{item.description}}</text></view><text class="status-tag {{item.statusClass}}">{{item.statusLabel}}</text><view class="reward-cost"><t-icon name="money" size="30rpx" /><text>{{item.cost}} {{item.pointsLabel}}积分 · {{item.beneficiaryType === 'couple' ? '两人共同' : item.beneficiaryType === 'partner' ? '给 TA' : '给我'}}</text></view></view></view>
      <view wx:if="{{!rewards.length}}" class="empty-state"><text class="empty-title">这个分类还没有奖励</text><text class="empty-copy">换个分类看看，或创建一份新的期待。</text></view>
    </block>
    <view class="floating-create-action {{createOpen ? 'is-open' : ''}}" hover-class="floating-create-action--pressed" bind:tap="toggleCreate"><text class="floating-create-icon">{{createOpen ? '×' : '＋'}}</text><text>{{createOpen ? '收起' : viewMode === 'tasks' ? '新建任务' : '新建奖励'}}</text></view>
  </block>
</view>
