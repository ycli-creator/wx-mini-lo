<page-meta root-font-size="system" />
<view class="screen chat-screen"><lp-header title="{{partnerName}}" /><lp-page-state wx:if="{{loading || loadError}}" loading="{{loading}}" error-text="消息加载失败，请重试" bind:retry="refresh" /><scroll-view wx:else scroll-y class="message-list" scroll-with-animation scroll-into-view="{{bottomMessage}}" style="bottom: calc({{keyboardHeight}}px + 136rpx + env(safe-area-inset-bottom));">
<view wx:if="{{!messages.length && !loading}}" class="empty-state"><text class="empty-title">还没有消息</text></view>
  <view wx:for="{{messages}}" wx:key="id" id="message-{{item.id}}" class="message-row {{item.senderIsSelf ? 'self' : 'partner'}}"><view wx:if="{{item.type === 'text'}}" class="message-bubble"><text>{{item.text}}</text></view><view wx:else class="message-card" data-id="{{item.id}}" bind:tap="openCard"><text class="message-kind">{{item.senderIsSelf ? '你 @了 TA' : 'TA @了你'}}</text><text class="message-title">{{item.title}}</text><text class="message-copy">{{item.description}}</text><view class="message-action">{{item.actionText || '去看看'}}<lp-icon name="line-right" size="32rpx" color="#b72f46" /></view></view></view>
</scroll-view><view class="chat-composer" style="bottom: {{keyboardHeight}}px;"><input class="chat-input" aria-label="消息内容" adjust-position="{{false}}" bindkeyboardheightchange="keyboardChange" maxlength="500" value="{{text}}" placeholder="说点什么…" bind:input="inputText" confirm-type="send" bind:confirm="send" /><button class="send-button" bind:tap="send" disabled="{{sending || loading || loadError || !text}}" loading="{{sending}}">{{sending ? "发送中" : "发送"}}</button></view></view>
