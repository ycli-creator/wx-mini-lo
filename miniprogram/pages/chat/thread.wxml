<view class="screen chat-screen"><lp-header title="{{partnerName}}" /><scroll-view scroll-y class="message-list" scroll-with-animation>
<view wx:if="{{!messages.length && !loading}}" class="empty-state"><text class="empty-title">还没有消息</text><text class="empty-copy">说点什么，或者从待办、日历和文档中 @TA。</text></view>
  <view wx:for="{{messages}}" wx:key="id" class="message-row {{item.senderIsSelf ? 'self' : 'partner'}}"><view wx:if="{{item.type === 'text'}}" class="message-bubble"><text>{{item.text}}</text></view><view wx:else class="message-card" data-id="{{item.id}}" bind:tap="openCard"><text class="message-kind">{{item.senderIsSelf ? '你 @了 TA' : 'TA @了你'}}</text><text class="message-title">{{item.title}}</text><text class="message-copy">{{item.description}}</text><text class="message-action">{{item.actionText || '去看看'}} ›</text></view></view>
</scroll-view><view class="chat-composer"><input class="chat-input" maxlength="500" value="{{text}}" placeholder="说点什么…" bind:input="inputText" confirm-type="send" bind:confirm="send" /><button class="send-button" bind:tap="send">发送消息</button></view></view>
