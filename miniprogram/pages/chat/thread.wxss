.chat-screen{display:flex;flex-direction:column;padding-bottom:calc(env(safe-area-inset-bottom) + 150rpx)}.message-list{flex:1;min-height:560rpx}.message-row{display:flex;margin-bottom:20rpx}.message-row.self{justify-content:flex-end}.message-bubble,.message-card{max-width:82%;padding:20rpx 24rpx;border-radius:28rpx}.message-bubble{background:#fff;border:2rpx solid var(--lp-border);font-size:28rpx;line-height:42rpx}.self .message-bubble{color:#fff;background:var(--lp-brand);border-color:var(--lp-brand)}.message-card{width:82%;background:#fff;border:2rpx solid var(--lp-border)}.message-kind,.message-title,.message-copy,.message-action{display:block}.message-kind{color:var(--lp-text-secondary);font-size:22rpx}.message-title{margin-top:10rpx;font-size:30rpx;font-weight:600}.message-copy{margin-top:6rpx;color:var(--lp-text-secondary);font-size:24rpx;line-height:38rpx}.message-action{margin-top:18rpx;color:var(--lp-brand-text);font-size:24rpx}.chat-composer{position:fixed;z-index:90;left:24rpx;right:24rpx;bottom:calc(env(safe-area-inset-bottom) + 24rpx);padding:14rpx;display:flex;gap:12rpx;background:#fff;border:2rpx solid var(--lp-border);border-radius:30rpx}.chat-input{min-width:0;height:72rpx;padding:0 18rpx;flex:1;font-size:28rpx}.send-button{min-width:144rpx;min-height:72rpx;margin:0;padding:0 20rpx;color:#fff;background:var(--lp-brand);border-radius:22rpx;font-size:24rpx;line-height:72rpx}.send-button::after{border:0}
