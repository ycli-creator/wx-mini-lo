<view class="screen"><lp-header title="情侣关系"/><lp-page-state wx:if="{{loading}}" loading loading-text="正在同步关系设置"/><block wx:else>
<view class="notice-card brand"><text class="notice-title">所有共同设置都需要双方同意</text><text class="notice-copy">任意一方可以随时撤回公开许可。撤回只会隐藏公开资料，不会影响情侣空间中的数据。</text></view>
<view class="section-heading"><text class="section-title">恋爱开始日期</text></view><view class="setting-panel"><text class="current-value">当前日期 {{startedAt}}</text><picker mode="date" end="{{today}}" value="{{selectedDate}}" bind:change="chooseDate"><view class="date-picker">{{selectedDate || '选择日期'}} ›</view></picker><button class="secondary-action" bind:tap="requestDate">请求修改日期</button></view>
<view class="section-heading"><text class="section-title">关系公开许可</text></view><view class="setting-panel"><text class="current-value">{{publicApproved ? '双方已允许公开' : '情侣关系保持私密'}}</text><text class="helper-copy">双方许可后，每个人仍可分别决定是否在自己的主页展示伴侣。</text><button wx:if="{{!publicApproved}}" class="secondary-action" bind:tap="requestPublic">请求公开关系</button><button wx:else class="danger-action" bind:tap="revokePublic">立即撤回公开</button></view>
<view wx:if="{{requests.length}}" class="section-heading"><text class="section-title">待确认设置</text></view><view wx:for="{{requests}}" wx:key="id" wx:if="{{item.canReview}}" class="request-panel"><view><text class="request-title">{{item.type === 'date' ? '修改恋爱开始日期' : '公开情侣关系'}}</text><text class="helper-copy">{{item.type === 'date' ? item.value : '同意后双方才可展示关系'}}</text></view><view class="review-actions"><button class="text-action" data-id="{{item.id}}" data-approved="{{false}}" bind:tap="review">拒绝申请</button><button class="secondary-action compact" data-id="{{item.id}}" data-approved="{{true}}" bind:tap="review">同意设置</button></view></view>
</block></view>
