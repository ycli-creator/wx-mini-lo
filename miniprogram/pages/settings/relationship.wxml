<page-meta root-font-size="system" />
<view class="screen"><lp-header title="情侣关系"/><lp-page-state wx:if="{{loading || loadError}}" loading="{{loading}}" error-text="关系设置加载失败，请重试" bind:retry="refresh"/><view wx:elif="{{!bound}}" class="empty-state"><text class="empty-title">尚未绑定伴侣</text><lp-button label="邀请 TA" bind:tap="invite"/></view><block wx:else>

<view class="section-heading"><text class="section-title">恋爱开始日期</text></view><view class="setting-panel"><text class="current-value">当前日期 {{startedAt}}</text><picker mode="date" end="{{today}}" value="{{selectedDate}}" bind:change="chooseDate"><view class="date-picker">{{selectedDate || '选择日期'}} <lp-icon name="line-right" size="32rpx" color="#81716a" /></view></picker><button class="secondary-action" bind:tap="requestDate" disabled="{{busy || !selectedDate || selectedDate === startedAt}}">请求修改日期</button></view>
<view class="section-heading"><text class="section-title">关系公开许可</text></view><view class="setting-panel"><text class="current-value">{{publicApproved ? '双方已允许公开' : '情侣关系保持私密'}}</text><button wx:if="{{!publicApproved}}" class="secondary-action" bind:tap="requestPublic" disabled="{{busy}}">请求公开关系</button><button wx:else class="danger-action" bind:tap="revokePublic" disabled="{{busy}}">立即撤回公开</button></view>
<view wx:if="{{requests.length}}" class="section-heading"><text class="section-title">待确认设置</text></view><view wx:for="{{requests}}" wx:key="id" class="request-panel"><view><text class="request-title">{{item.type === 'date' ? '修改恋爱开始日期' : '公开情侣关系'}}</text></view><text wx:if="{{item.type === 'date'}}" class="request-value">{{item.value}}</text><text wx:if="{{!item.canReview}}" class="request-status">等待 TA 确认</text><view wx:if="{{item.canReview}}" class="review-actions"><button class="text-action" data-id="{{item.id}}" data-approved="{{false}}" bind:tap="review" disabled="{{busy}}">拒绝申请</button><button class="secondary-action compact" data-id="{{item.id}}" data-approved="{{true}}" bind:tap="review" disabled="{{busy}}">同意设置</button></view></view>
</block></view>
