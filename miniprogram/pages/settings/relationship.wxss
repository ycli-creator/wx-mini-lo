.setting-panel,.request-panel{margin-bottom:30rpx;padding:28rpx;background:#fff;border:2rpx solid var(--lp-border);border-radius:30rpx}.current-value,.request-title,.helper-copy{display:block}.current-value,.request-title{font-size:30rpx;font-weight:600}.helper-copy{margin-top:8rpx;color:var(--lp-text-secondary);font-size:24rpx;line-height:38rpx}.date-picker{margin:20rpx 0;padding:20rpx 22rpx;background:var(--lp-bg-canvas);border-radius:22rpx}.secondary-action,.danger-action,.text-action{min-height:70rpx;margin:18rpx 0 0;border-radius:22rpx;font-size:24rpx;line-height:70rpx}.secondary-action{color:var(--lp-brand-text);background:var(--lp-brand-soft)}.danger-action{color:var(--lp-danger);background:var(--lp-danger-bg)}.text-action{color:var(--lp-text-secondary);background:transparent}.secondary-action::after,.danger-action::after,.text-action::after{border:0}.review-actions{display:flex;justify-content:flex-end;gap:10rpx}.review-actions button{margin-left:0;margin-right:0}.compact{padding:0 24rpx}
