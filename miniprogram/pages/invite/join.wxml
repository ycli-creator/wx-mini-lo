<view class="screen">
  <lp-header title="输入短码" subtitle="输入对方分享给你的 6 位绑定短码" />
  <view class="form-card">
    <text class="field-label">绑定短码</text>
    <input class="text-input" value="{{code}}" type="number" maxlength="6" placeholder="请输入 6 位数字" bind:input="handleCode" />
  </view>
  <text wx:if="{{error}}" class="field-error">{{error}}</text>
  <lp-button label="提交绑定申请" disabled="{{code.length !== 6}}" bind:tap="submit" />
  <lp-button label="返回" variant="text" bind:tap="goBack" />
</view>
