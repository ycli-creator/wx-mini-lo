.records-screen { padding-bottom: calc(env(safe-area-inset-bottom) + 190rpx); }
.calendar-card { margin-bottom: 30rpx; padding: 28rpx 22rpx 24rpx; background: #fff; border: 2rpx solid var(--lp-border); border-radius: 42rpx; box-shadow: 0 10rpx 34rpx rgba(78, 48, 39, 0.05); }
.month-nav { margin-bottom: 22rpx; display: flex; align-items: center; justify-content: space-between; }
.month-title { font-size: 32rpx; font-weight: 700; }
.month-arrow { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; color: var(--lp-brand-text); background: var(--lp-brand-soft); border-radius: 50%; font-size: 44rpx; }
.weekday-row, .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); }
.weekday-row { margin-bottom: 10rpx; color: var(--lp-text-secondary); font-size: 21rpx; text-align: center; }
.calendar-day { position: relative; min-height: 92rpx; margin: 3rpx; padding: 8rpx 2rpx 12rpx; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; border-radius: 22rpx; font-size: 25rpx; }
.day-number { line-height: 34rpx; }
.calendar-day.outside { color: #cbbeba; }
.calendar-day.today { color: var(--lp-brand-text); font-weight: 700; }
.calendar-day.selected { color: #fff; background: var(--lp-brand); }
.day-moods { height: 30rpx; display: flex; align-items: center; justify-content: center; letter-spacing: -5rpx; }
.day-mood { font-size: 23rpx; line-height: 30rpx; }
.day-markers { position: absolute; bottom: 6rpx; display: flex; gap: 4rpx; }
.day-dot, .legend-dot { width: 8rpx; height: 8rpx; display: inline-block; border-radius: 50%; }
.day-dot.event, .legend-dot.event { background: #5c8ed6; }
.day-dot.period, .legend-dot.period { background: #ef5f75; }
.calendar-day.selected .day-dot { border: 1rpx solid rgba(255,255,255,0.85); }
.calendar-legend { margin-top: 18rpx; display: flex; justify-content: center; gap: 28rpx; color: var(--lp-text-secondary); font-size: 20rpx; }
.calendar-legend > view { display: flex; align-items: center; gap: 8rpx; }
.legend-emoji { font-size: 22rpx; }
.record-cell { min-height: 128rpx; padding: 20rpx 26rpx; display: flex; align-items: center; gap: 20rpx; background: #fff; border: 2rpx solid var(--lp-border); border-radius: 30rpx; }
.record-icon { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; font-size: 31rpx; }
.record-icon.mood { background: #fff4da; }
.record-icon.event { color: #4d84c6; background: var(--lp-blue-bg); }
.record-icon.period { color: var(--lp-brand-text); background: var(--lp-brand-soft); }
.record-add-action { bottom: calc(env(safe-area-inset-bottom) + 28rpx); }
.drawer-backdrop { position: fixed; z-index: 120; inset: 0; display: flex; align-items: flex-end; background: rgba(47, 41, 40, 0.38); }
.record-drawer { width: 100%; max-height: 78vh; padding: 16rpx 30rpx calc(env(safe-area-inset-bottom) + 30rpx); background: var(--lp-bg-canvas); border-radius: 44rpx 44rpx 0 0; box-shadow: 0 -18rpx 60rpx rgba(47, 41, 40, 0.16); }
.drawer-handle { width: 76rpx; height: 8rpx; margin: 0 auto 22rpx; background: #dfd2cc; border-radius: 999rpx; }
.drawer-heading { margin-bottom: 22rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.drawer-title { display: block; font-size: 34rpx; font-weight: 700; line-height: 50rpx; }
.drawer-caption { display: block; color: var(--lp-text-secondary); font-size: 23rpx; line-height: 36rpx; }
.drawer-close { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; color: var(--lp-text-secondary); background: var(--lp-disabled); border-radius: 50%; font-size: 38rpx; }
.drawer-scroll { max-height: 48vh; }
.drawer-list { padding-bottom: 4rpx; }
.drawer-empty { margin-bottom: 24rpx; }
.drawer-action { min-height: 88rpx; margin-top: 20rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: var(--lp-brand); border-radius: 999rpx; font-weight: 700; }
.drawer-action--pressed { opacity: 0.86; }
