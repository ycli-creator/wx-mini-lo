<view class="screen community-create-screen">
  <lp-header title="{{editing ? '编辑帖子' : '记录一段日常'}}" subtitle="{{editing ? '标题概括主题，正文记录完整内容' : '先留在情侣空间，需要时再同步到社区'}}" />
  <view class="form-card title-card post-field-card">
    <text class="field-kicker">帖子标题</text><text class="field-help">一句话说清这篇记录是什么</text>
    <input class="text-input" maxlength="60" placeholder="给这段日常起个标题" value="{{title}}" bind:input="handleTitle" />
  </view>
  <view class="form-card post-field-card body-card">
    <text class="field-kicker">帖子正文</text><text class="field-help">展开写下过程、感受或想记住的细节</text>
    <textarea class="text-area post-editor" maxlength="1000" placeholder="记录今天发生的小事……" value="{{content}}" bind:input="handleContent" />
    <text class="editor-count">{{content.length}} / 1000</text>
  </view>
  <view wx:if="{{media.length}}" class="media-grid">
    <view wx:for="{{media}}" wx:key="localPath" class="media-preview">
      <image wx:if="{{item.type === 'image'}}" src="{{item.localPath}}" mode="aspectFill" />
      <video wx:else src="{{item.localPath}}" poster="{{item.posterPath}}" controls="{{false}}" show-center-play-btn="{{true}}" />
      <view class="remove-media" data-index="{{index}}" bind:tap="removeMedia">×</view>
    </view>
  </view>
  <view class="media-picker" hover-class="pressed" bind:tap="chooseMedia"><view class="cell-icon"><t-icon name="image" size="32rpx" /></view><view class="cell-copy"><text class="cell-title">添加照片或视频</text><text class="cell-subtitle">最多 9 个，支持图文、视频和纯文字</text></view><text class="cell-value">{{media.length}} / 9</text></view>
  <view class="community-sync {{syncToCommunity ? 'is-public' : ''}}">
    <view class="sync-copy"><text class="sync-title">同步到公开社区</text><text class="sync-description">{{privateMode ? '你已开启一键不展示，帖子只能留在情侣空间。' : syncToCommunity ? '发布后会先由 TA 确认，双方同意才会公开。' : '默认仅你和 TA 可见，不会出现在公开社区。'}}</text></view>
    <switch checked="{{syncToCommunity}}" disabled="{{privateMode}}" color="#f65f6b" bind:change="toggleCommunity" />
  </view>
  <view class="visibility-result"><t-icon name="lock-on" size="30rpx"/><text>{{syncToCommunity ? '当前：情侣确认后公开' : '当前：仅情侣空间可见'}}</text></view>
  <lp-button label="{{uploadProgress || (syncToCommunity ? (editing ? '保存修改并请 TA 重新确认' : '提交并请 TA 确认') : (editing ? '保存帖子修改' : '保存到情侣空间'))}}" disabled="{{!title || (!content && !media.length)}}" loading="{{busy}}" bind:tap="publish" />
</view>
