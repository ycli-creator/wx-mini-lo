<view class="screen community-create-screen">
  <lp-header title="{{editing ? '编辑帖子' : '记录一段日常'}}" subtitle="{{editing ? '标题概括主题，正文记录完整内容' : '只保存在你们两个人的空间里'}}" />
  <view class="form-card title-card post-field-card">
    <text class="field-kicker">帖子标题</text><text class="field-help">一句话说清这篇记录是什么</text>
    <input class="text-input" maxlength="60" placeholder="给这段日常起个标题" value="{{title}}" bind:input="handleTitle" />
  </view>
  <view class="form-card post-field-card body-card">
    <text class="field-kicker">帖子正文</text><text class="field-help">上线版本为纯文字记录，请完整写下过程或感受</text>
    <textarea class="text-area post-editor" maxlength="1000" placeholder="记录今天发生的小事……" value="{{content}}" bind:input="handleContent" />
    <text class="editor-count">{{content.length}} / 1000</text>
  </view>
  <view wx:if="{{media.length}}" class="media-grid">
    <view wx:for="{{media}}" wx:key="localPath" class="media-preview">
      <image wx:if="{{item.type === 'image'}}" src="{{item.localPath}}" mode="aspectFill" />
      <video wx:else src="{{item.localPath}}" poster="{{item.posterPath}}" controls="{{false}}" show-center-play-btn="{{true}}" />
      <view class="remove-media" data-index="{{index}}" bind:tap="removeMedia">×</view>
    </view>
  </view>
  <view class="media-picker is-disabled"><view class="cell-icon"><lp-icon name="info-circle" size="32rpx" /></view><view class="cell-copy"><text class="cell-title">图片与视频暂未开放</text><text class="cell-subtitle">内容审核能力接通前，发布仅支持纯文字</text></view></view>
  <view wx:if="{{!policyAccepted}}" class="policy-consent">
    <view class="policy-check {{policyAccepted ? 'checked' : ''}}" bind:tap="togglePolicy"><lp-icon name="check" size="24rpx" /></view>
    <text bind:tap="togglePolicy">我已阅读并同意</text><text class="policy-link" bind:tap="openPolicies">《用户协议与隐私说明》</text>
  </view>
  <view class="visibility-result"><lp-icon name="lock-on" size="30rpx"/><text>当前：仅情侣空间可见</text></view>
  <lp-button label="{{uploadProgress || (editing ? '保存帖子修改' : '保存到情侣空间')}}" disabled="{{!title || !content || media.length}}" loading="{{busy}}" bind:tap="publish" />
</view>
