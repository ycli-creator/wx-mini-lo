<view class="screen">
  <lp-header title="确认解除绑定" subtitle="这是最后一次确认，操作完成后不可恢复" />
  <lp-page-state wx:if="{{loading || loadError}}" loading="{{loading}}" loading-text="正在确认解绑申请" error-text="当前解绑申请无法确认，请重新加载或返回设置。" bind:retry="refresh" />
  <block wx:else>
  <view class="notice-card danger"><text class="notice-title">将清空情侣空间数据</text><text class="notice-copy">双方确认后，会清空任务、积分账户与流水、奖励、兑换记录和共享文档；微信用户身份仍会保留。</text></view>
  <lp-button label="同意解除并清空" variant="danger" loading="{{busy}}" bind:tap="approve" />
  <lp-button label="拒绝解除" variant="text" disabled="{{busy}}" bind:tap="reject" />
  </block>
</view>
