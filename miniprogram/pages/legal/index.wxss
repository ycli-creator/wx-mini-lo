.legal-screen{padding-bottom:calc(env(safe-area-inset-bottom) + 48rpx)}.legal-meta{margin-bottom:24rpx;padding:20rpx 24rpx;display:flex;flex-direction:column;gap:6rpx;color:var(--lp-text-secondary);background:var(--lp-brand-soft);border-radius:22rpx;font-size:21rpx}.legal-card{margin-bottom:20rpx;padding:28rpx;background:#fff;border:2rpx solid var(--lp-border);border-radius:28rpx}.legal-title,.legal-copy,.legal-item{display:block}.legal-title{margin-bottom:16rpx;font-size:30rpx;font-weight:700;line-height:44rpx}.legal-copy,.legal-item{color:var(--lp-text-secondary);font-size:25rpx;line-height:43rpx}.legal-copy+.legal-copy,.legal-item+.legal-item{margin-top:12rpx}.legal-notice{padding:22rpx;display:flex;align-items:flex-start;gap:12rpx;color:var(--lp-warning-text);background:var(--lp-warning-bg);border-radius:22rpx;font-size:22rpx;line-height:36rpx}.legal-notice text{min-width:0;flex:1}
