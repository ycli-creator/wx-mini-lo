.search-row{display:flex;gap:14rpx;margin-bottom:28rpx}.search-input{min-width:0;height:78rpx;padding:0 24rpx;flex:1;background:#fff;border:2rpx solid var(--lp-border);border-radius:24rpx;font-size:28rpx}.search-button,.soft-button,.text-button{margin:0;border-radius:20rpx;font-size:24rpx}.search-button{min-width:150rpx;color:#fff;background:var(--lp-brand);line-height:78rpx}.search-button::after,.soft-button::after,.text-button::after{border:0}.person-row{min-height:120rpx;padding:22rpx 0;display:flex;align-items:center;gap:20rpx;border-bottom:2rpx solid rgba(238,223,216,.72)}.person-avatar{width:76rpx;height:76rpx;flex:none;border-radius:50%}.person-avatar.empty{display:flex;align-items:center;justify-content:center;color:var(--lp-brand-text);background:var(--lp-brand-soft)}.person-copy{min-width:0;flex:1}.person-name,.person-meta{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.person-name{font-size:28rpx;font-weight:600}.person-meta{color:var(--lp-text-secondary);font-size:22rpx}.soft-button{padding:0 20rpx;color:var(--lp-brand-text);background:var(--lp-brand-soft);line-height:62rpx}.text-button{padding:0 12rpx;color:var(--lp-text-secondary);background:transparent;line-height:62rpx}.request-actions{display:flex;align-items:center;gap:6rpx}
