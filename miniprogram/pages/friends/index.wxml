<view class="screen"><lp-header title="好友" /><view class="search-row"><input name="identityCode" aria-label="好友身份码" class="search-input" maxlength="20" value="{{code}}" placeholder="输入 LP-XXXX-XXXX" bind:input="inputCode" confirm-type="search" bind:confirm="search"/><button class="search-button" bind:tap="search">搜索用户</button></view>
<view wx:if="{{result}}" class="person-row"><image wx:if="{{result.avatarUrl}}" class="person-avatar" src="{{result.avatarUrl}}"/><view wx:else class="person-avatar empty"><t-icon name="user-avatar" size="38rpx"/></view><view class="person-copy"><text class="person-name">{{result.nickname}}</text><text class="person-meta">{{result.region || result.identityCode}}</text></view><button class="soft-button" bind:tap="addFriend">发送申请</button></view>
<view wx:if="{{requests.length}}" class="section-heading"><text class="section-title">待处理申请</text></view><view wx:for="{{requests}}" wx:key="id" class="person-row"><view class="person-avatar empty"><t-icon name="user-avatar" size="38rpx"/></view><view class="person-copy"><text class="person-name">{{item.user.nickname}}</text><text class="person-meta">{{item.user.identityCode}}</text></view><view class="request-actions"><button class="text-button" data-id="{{item.id}}" data-approved="{{false}}" bind:tap="review">拒绝</button><button class="soft-button" data-id="{{item.id}}" data-approved="{{true}}" bind:tap="review">添加好友</button></view></view>
<view class="section-heading"><text class="section-title">我的好友</text><text class="section-caption">{{friends.length}} 人</text></view><view wx:if="{{!friends.length}}" class="empty-state"><text class="empty-title">还没有好友</text><text class="empty-copy">通过身份码添加好友。好友不会自动进入情侣空间，也不能直接查看情侣内容。</text></view><view wx:for="{{friends}}" wx:key="identityCode" class="person-row"><image wx:if="{{item.avatarUrl}}" class="person-avatar" src="{{item.avatarUrl}}"/><view wx:else class="person-avatar empty"><t-icon name="user-avatar" size="38rpx"/></view><view class="person-copy"><text class="person-name">{{item.nickname}}</text><text class="person-meta">{{item.region || item.identityCode}}</text></view></view></view>
