.tabbar { position: fixed; z-index: 100; left: 0; right: 0; bottom: 0; min-height: 132rpx; padding: 12rpx 14rpx calc(12rpx + env(safe-area-inset-bottom)); display: grid; grid-template-columns: repeat(5, 1fr); background: rgba(255, 255, 255, 0.96); border-top: 2rpx solid rgba(238, 223, 216, 0.9); box-shadow: 0 -16rpx 48rpx rgba(78, 48, 39, 0.045); }
.item { min-height: 108rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; color: #9d8f89; border-radius: 26rpx; }
.item.active { color: #e84a57; font-weight: 700; }
.pressed { background: #fff1f0; transform: scale(0.97); }
.icon-wrap { position: relative; width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; }
.dot { position: absolute; right: -2rpx; bottom: 0; width: 10rpx; height: 10rpx; background: #f65f6b; border: 4rpx solid #fff; border-radius: 50%; }
.label { font-size: 22rpx; line-height: 32rpx; }
