@import "./styles/tokens.wxss";

page {
  min-height: 100%;
  color: var(--lp-text-primary);
  background: var(--lp-bg-canvas);
  font-family: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, textarea { box-sizing: border-box; }

.screen {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 96rpx) 30rpx calc(env(safe-area-inset-bottom) + 64rpx);
}

.screen.with-tabbar { padding-bottom: calc(env(safe-area-inset-bottom) + 160rpx); }
.screen.with-tabbar.has-floating-action { padding-bottom: calc(env(safe-area-inset-bottom) + 280rpx); }
.stack { display: flex; flex-direction: column; gap: 24rpx; }
.section-gap { margin-bottom: 32rpx; }

.notice-card, .form-card, .points-card, .info-card {
  width: 100%;
  margin-bottom: 28rpx;
  padding: 36rpx 40rpx;
  background: var(--lp-bg-surface);
  border: 2rpx solid var(--lp-border);
  border-radius: 48rpx;
}

.notice-card.brand { background: var(--lp-brand-soft); }
.notice-card.blue { background: var(--lp-blue-bg); }
.notice-card.warning { background: var(--lp-warning-bg); }
.notice-card.success { background: var(--lp-success-bg); }
.notice-card.danger { background: var(--lp-danger-bg); border-color: var(--lp-brand); }
.notice-title { display: block; margin-bottom: 10rpx; font-size: 36rpx; font-weight: 600; line-height: 52rpx; }
.notice-copy { color: var(--lp-text-secondary); font-size: 28rpx; line-height: 46rpx; }

.field-label { display: block; margin-bottom: 8rpx; font-size: 32rpx; font-weight: 600; line-height: 48rpx; }
.field-hint { display: block; color: var(--lp-text-secondary); font-size: 24rpx; line-height: 36rpx; }
.text-input, .text-area {
  width: 100%;
  color: var(--lp-text-primary);
  font-size: 30rpx;
  line-height: 48rpx;
}
.text-input { height: 72rpx; }
.text-area { min-height: 150rpx; }
.text-area.document { min-height: 360rpx; }
.field-error { margin: -12rpx 8rpx 24rpx; color: var(--lp-danger); font-size: 24rpx; }
.invite-code { display: block; margin-top: 4rpx; color: var(--lp-text-secondary); font-size: 48rpx; font-weight: 700; letter-spacing: 8rpx; }

.list { display: flex; flex-direction: column; gap: 24rpx; margin-bottom: 28rpx; }
.list-cell {
  min-height: 144rpx;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: var(--lp-bg-surface);
  border: 2rpx solid var(--lp-border);
  border-radius: 32rpx;
}
.cell-icon { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; color: var(--lp-brand-text); background: var(--lp-brand-soft); border-radius: 18rpx; font-size: 30rpx; }
.cell-copy { min-width: 0; flex: 1; }
.cell-title { display: block; overflow: hidden; font-size: 32rpx; line-height: 48rpx; text-overflow: ellipsis; white-space: nowrap; }
.cell-subtitle { display: block; overflow: hidden; color: var(--lp-text-secondary); font-size: 24rpx; line-height: 38rpx; text-overflow: ellipsis; white-space: nowrap; }
.cell-value { color: var(--lp-brand-text); font-size: 24rpx; white-space: nowrap; }
.chevron { color: #b9aaa4; font-size: 34rpx; }

.points-card { display: grid; grid-template-columns: 1fr 1fr; background: var(--lp-brand-soft); }
.points-card.solo { grid-template-columns: 1fr; }
.points-column + .points-column { padding-left: 40rpx; border-left: 2rpx solid #f1d9d6; }
.points-label { display: block; color: var(--lp-text-secondary); font-size: 26rpx; }
.points-value { display: block; margin-top: 8rpx; font-size: 44rpx; font-weight: 700; }

.segment { margin-bottom: 28rpx; padding: 8rpx; display: grid; grid-template-columns: 1fr 1fr; background: var(--lp-disabled); border-radius: 28rpx; }
.segment-item { min-height: 80rpx; display: flex; align-items: center; justify-content: center; color: var(--lp-text-secondary); border-radius: 22rpx; }
.segment-item.active { color: var(--lp-text-primary); background: var(--lp-bg-surface); font-weight: 600; box-shadow: 0 4rpx 16rpx rgba(77, 50, 42, 0.07); }
.plan-type-segment { grid-template-columns: repeat(3, 1fr); }
.plan-filter-scroll { width: 100%; margin: -4rpx 0 28rpx; white-space: nowrap; }
.plan-filters { display: inline-flex; gap: 14rpx; padding: 2rpx; }
.plan-filter { min-width: 126rpx; min-height: 68rpx; padding: 12rpx 24rpx; display: inline-flex; align-items: center; justify-content: center; color: var(--lp-text-secondary); background: #fff; border: 2rpx solid var(--lp-border); border-radius: 999rpx; }
.plan-filter.active { color: #fff; background: var(--lp-brand); border-color: var(--lp-brand); font-weight: 600; }

.status-tag { min-height: 52rpx; padding: 6rpx 18rpx; display: inline-flex; align-items: center; border-radius: 999rpx; font-size: 22rpx; }
.status-todo { color: var(--lp-brand-text); background: var(--lp-brand-soft); }
.status-pending { color: var(--lp-blue); background: var(--lp-blue-bg); }
.status-done { color: var(--lp-success); background: var(--lp-success-bg); }
.status-warning { color: var(--lp-warning-text); background: var(--lp-warning-bg); }

.section-heading { margin: 6rpx 4rpx 18rpx; display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; }
.section-title { font-size: 32rpx; font-weight: 700; }
.section-caption { color: var(--lp-text-secondary); font-size: 22rpx; }
.empty-state { padding: 54rpx 36rpx; color: var(--lp-text-secondary); background: #fff; border: 2rpx dashed var(--lp-border); border-radius: 36rpx; text-align: center; }
.empty-title { display: block; margin-bottom: 10rpx; color: var(--lp-text-primary); font-size: 30rpx; font-weight: 600; }
.empty-copy { font-size: 24rpx; line-height: 40rpx; }
.safe-actions { display: flex; flex-direction: column; gap: 8rpx; }

.ledger-row, .reward-card {
  width: 100%;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: #fff;
  border: 2rpx solid var(--lp-border);
  border-radius: 32rpx;
}
.ledger-amount { margin-left: auto; text-align: right; white-space: nowrap; }
.ledger-amount .amount { display: block; font-size: 30rpx; }
.ledger-amount .balance { display: block; color: var(--lp-text-secondary); font-size: 22rpx; }
.ledger-amount.positive .amount { color: var(--lp-success); }
.ledger-amount.negative .amount { color: var(--lp-brand-text); }
.reward-card { min-height: 250rpx; align-items: flex-start; flex-wrap: wrap; border-radius: 48rpx; box-shadow: 0 8rpx 32rpx rgba(78, 48, 39, 0.06); }
.reward-icon { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; color: var(--lp-brand-text); background: var(--lp-brand-soft); border-radius: 28rpx; font-size: 38rpx; }
.reward-cost { width: 100%; display: flex; align-items: center; gap: 8rpx; color: var(--lp-warning-text); font-size: 32rpx; line-height: 48rpx; }
.floating-create-action {
  position: fixed;
  z-index: 90;
  left: 50%;
  bottom: calc(env(safe-area-inset-bottom) + 160rpx);
  transform: translateX(-50%);
  min-width: 260rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 18rpx 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #ffffff;
  background: var(--lp-brand);
  border: 2rpx solid var(--lp-brand);
  border-radius: 999rpx;
  box-shadow: 0 16rpx 40rpx rgba(232, 74, 87, 0.28);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}
.floating-create-action.is-open { color: var(--lp-brand-text); background: #ffffff; }
.floating-create-action--pressed { transform: translateX(-50%) scale(0.97); opacity: 0.92; }
.floating-create-icon { font-size: 36rpx; font-weight: 400; line-height: 1; }
.create-panel { margin-bottom: 28rpx; padding: 30rpx; background: #fff; border: 2rpx solid var(--lp-border); border-radius: 36rpx; }
.create-field { margin-bottom: 22rpx; padding: 18rpx 24rpx; background: var(--lp-bg-canvas); border: 2rpx solid var(--lp-border); border-radius: 26rpx; }
.switch-row { min-height: 112rpx; margin-bottom: 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.choice-wrap { margin: 18rpx 0 28rpx; display: flex; flex-wrap: wrap; gap: 16rpx; }
.choice-chip { min-height: 68rpx; padding: 12rpx 24rpx; display: flex; align-items: center; color: var(--lp-text-secondary); background: var(--lp-disabled); border: 2rpx solid transparent; border-radius: 999rpx; }
.choice-chip.active { color: var(--lp-brand-text); background: var(--lp-brand-soft); border-color: var(--lp-brand); }
.document-groups { display: flex; flex-direction: column; gap: 12rpx; }
.confirmation-row { min-height: 116rpx; padding: 20rpx 28rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; background: #fff; border: 2rpx solid var(--lp-border); border-radius: 30rpx; }
.confirmation-copy { min-width: 0; }
.confirmation-value { color: var(--lp-brand-text); font-size: 24rpx; white-space: nowrap; }
