:host {
  display: inline-flex;
  flex: none;
  color: inherit;
  line-height: 1;
  vertical-align: middle;
}

.lp-icon {
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  color: inherit;
}

.lp-icon__glyph {
  width: 100%;
  height: 100%;
  background: currentColor;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-size: contain;
  mask-size: contain;
}
