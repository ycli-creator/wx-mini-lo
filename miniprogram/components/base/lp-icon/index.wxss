:host {
  display: inline-flex;
  flex: none;
  color: inherit;
  line-height: 1;
  vertical-align: middle;
}

.lp-icon {
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  color: inherit;
}

.lp-icon__glyph {
  display: block;
  width: 82%;
  height: 82%;
  min-width: min(12px, 100%);
  min-height: min(12px, 100%);
}
