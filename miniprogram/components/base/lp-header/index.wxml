<view class="header {{showBack ? 'has-back' : ''}}">
  <view class="safe-top"></view>
  <view class="heading-row">
    <view wx:if="{{showBack}}" class="back-button" hover-class="back-button--pressed" role="button" aria-label="返回上一页" bind:tap="goBack"><text class="back-icon">‹</text></view>
    <view class="heading-copy">
      <text class="title">{{title}}</text>
      <text class="subtitle" wx:if="{{subtitle}}">{{subtitle}}</text>
    </view>
  </view>
</view>
