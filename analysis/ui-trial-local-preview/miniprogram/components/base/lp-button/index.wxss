:host {
  display: block;
  margin-bottom: 18rpx;
  --td-brand-color: #c83d53;
  --td-brand-color-active: #b72f46;
  --td-brand-color-light: #fff1f0;
  --td-button-primary-bg-color: #c83d53;
  --td-button-primary-border-color: #c83d53;
  --td-button-primary-active-bg-color: #b72f46;
  --td-button-primary-active-border-color: #b72f46;
  --td-button-light-bg-color: #fff1f0;
  --td-button-light-border-color: #fff1f0;
  --td-button-light-color: #b72f46;
  --td-button-danger-bg-color: #db3f50;
  --td-button-danger-border-color: #db3f50;
  --td-button-border-radius: 20rpx;
  --td-button-large-height: 96rpx;
}
.lp-button { font-weight: 600; }
.lp-button--soft { --td-button-light-bg-color: #fff1f0; --td-button-light-color: #b72f46; }
.lp-button--text { --td-button-light-bg-color: transparent; --td-button-light-color: #b72f46; }
