:host { display: block; }
.header { margin-bottom: 28rpx; }
.heading-row { min-height: 72rpx; display: flex; align-items: center; }
.heading-copy { min-width: 0; flex: 1; }
.back-button { width: 88rpx; min-width: 44px; min-height: max(44px, 88rpx); margin: 0 12rpx 0 -16rpx; padding: 0; display: flex; flex: none; align-items: center; justify-content: center; background: transparent; }
.back-button::after { border: 0; }
.back-button--pressed { opacity: 0.72; transform: scale(0.96); }
.title { display: block; color: #2f2928; font-size: var(--lp-type-title, 56rpx); font-weight: 600; line-height: 1.29; overflow-wrap: anywhere; }
.has-back .title { font-size: var(--lp-type-section, 40rpx); line-height: 1.3; }
.subtitle { display: block; margin-top: 2rpx; color: #8a7c78; font-size: 24rpx; line-height: 36rpx; }
