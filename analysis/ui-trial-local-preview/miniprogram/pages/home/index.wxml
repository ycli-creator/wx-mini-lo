<page-meta root-font-size="system" />
<view class="screen with-tabbar home-screen ui-trial">
  <view class="home-heading">
    <text class="ui-title">首页</text>
    <button class="ui-control ui-icon-button notification-button" bindtap="openMessages" hover-class="ui-press" hover-start-time="20" aria-label="{{unread ? '消息，有未读消息' : '消息'}}">
      <lp-icon name="line-bell" size="46rpx" color="#403631" />
      <view wx:if="{{unread > 0}}" class="notification-dot"></view>
    </button>
  </view>
  <lp-page-state wx:if="{{loading || loadError}}" loading="{{loading}}" loading-text="加载中…" error-text="加载失败，请重试" bind:retry="refresh" />
  <block wx:else>
    <view class="memory-banner {{state.profile.backgroundUrl ? 'has-photo' : ''}}">
      <image wx:if="{{state.profile.backgroundUrl}}" class="banner-image" src="{{state.profile.backgroundUrl}}" mode="aspectFill" />
      <view wx:if="{{state.profile.backgroundUrl}}" class="banner-shade"></view>
      <view class="banner-content">
        <text class="banner-space">{{state.activeSpaceType === 'couple' ? state.profile.nickname + ' · ' + state.partnerProfile.nickname : state.profile.nickname}}</text>
        <text class="banner-title">{{state.activeSpaceType === 'couple' ? (relationshipDays ? '相伴 ' + relationshipDays + ' 天' : '情侣空间') : '个人空间'}}</text>
      </view>
    </view>

    <view class="ui-group home-shortcuts">
      <button class="ui-control home-row diary-entry" bindtap="openDiary" hover-class="ui-press" hover-start-time="20">
        <lp-icon name="line-book" size="46rpx" color="#b72f46" />
        <text class="home-row-title">日记</text>
        <lp-icon name="line-right" size="32rpx" color="#81716a" />
      </button>
      <view class="tool-grid">
        <button class="ui-control tool-item" bindtap="openPoints" hover-class="ui-press" hover-start-time="20">
          <lp-icon name="line-wallet" size="46rpx" color="#493d38" />
          <text>积分</text>
          <text class="tool-value ui-number">{{state.activeSpaceType === 'couple' ? state.sharedPoints : state.personalPoints}}</text>
        </button>
        <button class="ui-control tool-item" bindtap="openRewards" hover-class="ui-press" hover-start-time="20">
          <lp-icon name="line-heart" size="46rpx" color="#493d38" />
          <text>心愿</text><text class="tool-value ui-number">{{state.rewards.length}} 个</text>
        </button>
        <button class="ui-control tool-item" bindtap="openDocuments" hover-class="ui-press" hover-start-time="20">
          <lp-icon name="line-file" size="46rpx" color="#493d38" />
          <text>文档</text><text class="tool-value ui-number">{{state.documents.length}} 个</text>
        </button>
        <button class="ui-control tool-item" bindtap="openCalendar" hover-class="ui-press" hover-start-time="20">
          <lp-icon name="line-calendar" size="46rpx" color="#493d38" />
          <text>日历</text>
        </button>
      </view>
    </view>

    <view class="home-section-heading">
      <text class="section-title">{{taskSectionTitle}}</text>
      <button class="ui-control section-link" bindtap="openTaskList" hover-class="ui-press-text">全部待办 <lp-icon name="line-right" size="32rpx" color="#b72f46" /></button>
    </view>
    <view class="ui-group home-activity">
      <button wx:if="{{hasTask}}" class="ui-control home-row task-preview" bindtap="openTask" hover-class="ui-press" hover-start-time="20" aria-label="{{task.title}}，{{taskStatusLabel}}，奖励 {{task.points}} 积分">
        <lp-icon name="{{task.status === 'done' ? 'line-check' : task.status === 'pending' ? 'line-clock' : 'line-clipboard'}}" size="38rpx" color="{{task.status === 'done' ? '#506f2c' : '#b72f46'}}" />
        <view class="task-preview-copy">
          <text class="home-row-title">{{task.title}}</text>
          <view class="task-preview-meta"><text>+{{task.points}} 积分{{task.bothRequired ? '/人' : ''}}</text><text wx:if="{{task.kind === 'project'}}">{{task.progressPercent || 0}}%</text></view>
          <view wx:if="{{task.bothRequired}}" class="task-members"><text>我 · {{task.selfCompletion.completed ? '已完成' : '待完成'}}</text><text>TA · {{task.partnerCompletion.completed ? '已完成' : '待完成'}}</text></view>
        </view>
        <text wx:if="{{task.status !== 'todo'}}" class="task-preview-status {{task.status === 'done' ? 'is-done' : ''}}">{{taskStatusLabel}}</text>
        <lp-icon name="line-right" size="32rpx" color="#81716a" />
      </button>
      <view wx:else class="home-row empty-task"><text>暂无待处理事项</text></view>
      <button wx:if="{{state.activeSpaceType === 'couple'}}" class="ui-control home-row heat-strip" bindtap="openHeat" hover-class="ui-press" hover-start-time="20">
        <lp-icon name="line-heart" size="46rpx" color="#b72f46" />
        <text class="home-row-title">情侣热力</text>
        <text class="heat-count ui-number">{{state.heat.completedCount}}/5</text><text class="heat-number ui-number">+{{state.heat.todayHeat}}</text>
        <lp-icon name="line-right" size="32rpx" color="#81716a" />
      </button>
      <button wx:if="{{rewardNeedsAction}}" class="ui-control home-row action-notice" bindtap="openRewards" hover-class="ui-press" hover-start-time="20">
        <lp-icon name="line-gift" size="46rpx" color="#b72f46" /><text class="home-row-title">{{rewardHint}}</text><lp-icon name="line-right" size="32rpx" color="#81716a" />
      </button>
    </view>
  </block>
</view>
