.community-screen { padding-left: 30rpx; padding-right: 30rpx; }
.feed-list { display: flex; flex-direction: column; gap: 20rpx; }
.feed-card { padding: 28rpx; background: var(--lp-bg-surface); border-radius: var(--lp-radius-card); }
.feed-author { display: flex; align-items: center; gap: 14rpx; margin-bottom: 22rpx; }
.mini-avatar { width: 52rpx; height: 52rpx; flex: none; overflow: hidden; display: flex; align-items: center; justify-content: center; color: var(--lp-brand-text); background: var(--lp-brand-soft); border-radius: 50%; }
.mini-avatar image { width: 100%; height: 100%; }
.couple-name { min-width: 0; flex: 1; overflow: hidden; color: var(--lp-text-primary); font-size: var(--lp-type-meta); text-overflow: ellipsis; white-space: nowrap; }
.feed-date { flex: none; color: var(--lp-text-secondary); font-size: var(--lp-type-meta); }
.feed-title { display: block; margin-bottom: 12rpx; font-size: var(--lp-type-body); font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; }
.feed-content { display: block; color: var(--lp-text-primary); font-size: var(--lp-type-body); line-height: 1.4; white-space: pre-wrap; overflow-wrap: anywhere; }
.feed-cover-wrap, .feed-video-wrap { position: relative; overflow: hidden; margin-top: 22rpx; border-radius: var(--lp-radius-control); }
.feed-cover, .feed-video { display: block; width: 100%; height: 360rpx; background: var(--lp-disabled); }
.media-count { position: absolute; right: 16rpx; bottom: 16rpx; padding: 4rpx 12rpx; color: #fff; background: rgba(0,0,0,.6); border-radius: 12rpx; font-size: var(--lp-type-meta); }
.post-more { flex: none; display: flex; align-items: center; justify-content: center; min-width: var(--lp-touch-target); min-height: var(--lp-touch-target); padding: 0; margin: -12rpx -12rpx -12rpx 0; border-radius: 50%; background: transparent; }
.post-more::after { border: 0; }
.community-screen .empty-state { gap: 24rpx; }
.community-screen .floating-create-action { margin: 0; line-height: 1.5; }
.community-screen .floating-create-action::after { border: 0; }
