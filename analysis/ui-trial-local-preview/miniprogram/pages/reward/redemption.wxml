<page-meta root-font-size="system" />
<view class="screen">
  <lp-header title="兑换记录" />
  <lp-page-state wx:if="{{loading || loadError}}" loading="{{loading}}" loading-text="正在读取兑换记录" error-text="兑换记录暂时无法读取，请重新加载。" bind:retry="refresh" />
  <block wx:else>
  <view class="notice-card {{redemption.refundStatus === 'approved' ? 'success' : redemption.status === 'pending' ? 'warning' : 'brand'}}"><text class="notice-title">{{redemption.refundStatus === 'approved' ? '退款已完成' : redemption.status === 'pending' ? '等待兑换审批' : reward.name}}</text><text class="notice-copy">{{redemption.refundStatus === 'approved' ? '积分已原路返还。' : redemption.status === 'pending' ? '需要指定的另一方同意后才会扣除积分。' : reward.condition}}</text></view>
  <view class="list">
    <view class="confirmation-row"><view class="confirmation-copy"><text class="cell-title">兑换状态</text></view><text class="confirmation-value">{{redemption.refundStatus === 'approved' ? '已退款' : redemption.status === 'pending' ? '待确认' : '已兑换'}}</text></view>
    <view class="confirmation-row"><text class="cell-title">退款状态</text><text class="confirmation-value">{{redemption.refundStatus === 'rejected' ? '退款未通过' : redemption.refundStatus === 'approved' ? '已退款' : redemption.refundStatus === 'requested' ? '待确认' : '未申请'}}</text></view>
  </view>
  <block wx:if="{{redemption.status === 'pending' && redemption.canReview}}">
    <lp-button label="同意兑换" loading="{{busy}}" bind:tap="approveRedemption" />
    <lp-button label="拒绝兑换" variant="text" disabled="{{busy}}" bind:tap="rejectRedemption" />
  </block>
  <view wx:elif="{{redemption.status === 'pending'}}" class="notice-copy">等待 TA 确认兑换</view>
  <block wx:elif="{{redemption.refundStatus === 'requested' && redemption.refundCanReview}}">
    <lp-button label="同意退款" loading="{{busy}}" bind:tap="approveRefund" />
    <lp-button label="拒绝退款" variant="text" disabled="{{busy}}" bind:tap="rejectRefund" />
  </block>
  <view wx:elif="{{redemption.refundStatus === 'requested'}}" class="notice-copy">退款申请已发送，等待 TA 确认</view>
  <lp-button wx:elif="{{redemption.status === 'active' && redemption.requesterIsSelf && (redemption.refundStatus === 'none' || redemption.refundStatus === 'rejected')}}" label="{{redemption.refundStatus === 'rejected' ? '重新申请退款' : '申请退款'}}" variant="soft" loading="{{busy}}" bind:tap="requestRefund" />
  <lp-button label="返回心愿商店" variant="text" bind:tap="goRewards" />
  </block>
</view>
