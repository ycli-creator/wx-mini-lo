.heat-summary { margin-bottom: 36rpx; padding: 40rpx; color: #6d352d; background: #fff0e8; border-radius: var(--lp-radius-surface); }
.heat-label,.heat-today,.heat-description { display:block; color:var(--lp-text-secondary); }
.heat-value { display:block; margin:8rpx 0; font-size:72rpx; font-weight:600; font-variant-numeric:tabular-nums; }
.heat-today,.heat-description { font-size: var(--lp-type-meta); line-height: 1.3; }
.heat-list { display:flex; flex-direction:column; gap:0; }
.heat-task { padding:28rpx 4rpx; border-bottom:1rpx solid var(--lp-border); }
.heat-task.done { opacity:.7; }
.heat-title-row,.heat-meta,.heat-actions { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.heat-task-title { font-size: var(--lp-type-body); font-weight:600; }
.heat-description { margin-top:8rpx; }
.heat-meta { margin-top:18rpx; color:var(--lp-text-secondary); font-size: var(--lp-type-meta); }
.heat-actions { margin-top:20rpx; padding-top:18rpx; border-top:2rpx solid rgba(82,52,43,.07); }
.heat-action,.cue-action { min-height:64rpx; padding:12rpx 20rpx; display:flex; align-items:center; color:var(--lp-brand-text); }
.cue-action { color:#fff; background:var(--lp-brand); border-radius:999rpx; }
.share-action { min-height:64rpx; margin:0; padding:0 18rpx; color:var(--lp-text-secondary); background:transparent; font-size: var(--lp-type-meta); line-height:64rpx; }
.share-action::after { border:0; }

.heat-action,.cue-action,.share-action{min-height:88rpx;line-height:1.5;font-size: var(--lp-type-meta)}.heat-actions{flex-wrap:wrap}.heat-task-title{overflow-wrap:anywhere}.heat-meta{font-size: var(--lp-type-meta)}
