.statistics-page { position: relative; min-height: 100vh; padding-bottom: 150rpx; background: var(--lp-bg-canvas); }.statistics-nav { position: absolute; left: 26rpx; height: 54px; display: flex; align-items: center; }.statistics-nav button { width: 70rpx; height: 70rpx; padding: 16rpx; margin: 0; background: transparent; }.statistics-nav image { width: 38rpx; height: 38rpx; opacity: .7; }.statistics-encounter { min-height: 44vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40rpx 28rpx 75rpx; }.encounter-you { font-size: 72rpx; font-weight: 300; letter-spacing: 12rpx; }.encounter-days { display: flex; align-items: baseline; justify-content: center; margin-top: 75rpx; font-size: 35rpx; font-weight: 300; white-space: nowrap; }.encounter-number { font-size: 68rpx; font-weight: 300; line-height: 1; }.encounter-since { margin-top: 28rpx; font-size: var(--lp-type-meta); color: var(--lp-text-secondary); text-align: center; }.statistics-totals { display: flex; justify-content: space-around; gap: 12rpx; margin: 0 60rpx; padding: 66rpx 0; border-top: 1rpx solid var(--lp-border); border-bottom: 1rpx solid var(--lp-border); text-align: center; }.statistics-totals > view { flex: 1; min-width: 0; }.total-label { display: block; font-size: var(--lp-type-meta); color: var(--lp-text-secondary); }.total-value { display: block; margin-top: 18rpx; font-size: 44rpx; font-weight: 300; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }.year-review-button { margin: 50rpx auto 20rpx; padding: 16rpx 20rpx; background: transparent; font-size: var(--lp-type-meta); letter-spacing: 7rpx; color: var(--lp-text-primary); }.statistics-landscape { display: block; position: absolute; bottom: 0; left: 0; width: 100%; opacity: .3; }.annual-review { margin: 35rpx 42rpx 80rpx; padding: 32rpx; border: 1rpx solid var(--lp-border); border-radius: 18rpx; background: var(--lp-bg-surface); }.annual-year { font-size: var(--lp-type-body); margin-bottom: 18rpx; }.annual-summary { display: block; margin-top: 12rpx; font-size: var(--lp-type-meta); color: var(--lp-text-secondary); }.annual-chart { margin-top: 26rpx; }.annual-row { display: flex; align-items: center; gap: 20rpx; margin: 18rpx 0; font-size: var(--lp-type-meta); color: var(--lp-text-secondary); }.annual-row > text:first-child { width: 70rpx; }.annual-row > text:last-child { width: 40rpx; text-align: right; }.annual-track { height: 12rpx; flex: 1; border-radius: 8rpx; background: var(--lp-disabled); }.annual-track view { min-width: 0; height: 100%; border-radius: 8rpx; background: var(--lp-brand); }button::after { border: none; }


.statistics-encounter{min-height:30vh;padding:36rpx 28rpx}.encounter-you{font-size:40rpx;font-weight:600;letter-spacing:0}.encounter-days{margin-top:36rpx}.encounter-since{font-size: var(--lp-type-meta);line-height: 1.3}.statistics-totals{padding:36rpx 0}.year-review-button{min-height:88rpx;letter-spacing:0;font-weight:600}.statistics-nav button{width:88rpx;height:88rpx}.statistics-landscape{display:none}
