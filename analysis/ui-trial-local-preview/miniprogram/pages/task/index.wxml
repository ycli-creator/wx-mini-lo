<page-meta root-font-size="system" />
<view class="screen with-tabbar task-screen ui-trial">
  <view class="task-heading">
    <text class="ui-title">{{viewMode === 'tasks' ? (state.activeSpaceType === 'couple' ? '我们的待办' : '我的待办') : '心愿商店'}}</text>
  </view>
  <view class="task-controls">
    <view class="segment task-main-segment" aria-role="tablist" aria-label="待办与心愿">
      <button class="ui-control segment-item {{viewMode === 'tasks' ? 'active' : ''}}" aria-role="tab" aria-selected="{{viewMode === 'tasks'}}" disabled="{{busy}}" data-view="tasks" bindtap="switchView" hover-class="ui-press-text">待办</button>
      <button class="ui-control segment-item {{viewMode === 'shop' ? 'active' : ''}}" aria-role="tab" aria-selected="{{viewMode === 'shop'}}" disabled="{{busy}}" data-view="shop" bindtap="switchView" hover-class="ui-press-text">心愿商店</button>
    </view>
    <button wx:if="{{!loading && !loadError}}" class="ui-control ui-primary task-create {{createOpen ? 'is-open' : ''}} {{busy ? 'is-disabled' : ''}}" hover-class="{{createOpen ? 'ui-press' : 'ui-primary-pressed'}}" hover-start-time="20" bindtap="toggleCreate" disabled="{{busy}}" aria-expanded="{{createOpen}}">
      <lp-icon name="{{createOpen ? 'line-close' : 'line-plus'}}" size="34rpx" color="{{createOpen ? '#403631' : '#ffffff'}}" />
      <text>{{createOpen ? '收起' : viewMode === 'tasks' ? '创建待办' : '创建心愿'}}</text>
    </button>
  </view>
  <lp-page-state wx:if="{{loading || loadError}}" loading="{{loading}}" loading-text="加载中…" error-text="待办和心愿加载失败，请重试" bind:retry="refresh" />

  <block wx:else>
    <block wx:if="{{viewMode === 'tasks'}}">
      <view wx:if="{{createOpen}}" class="create-panel creator-card">
        <view class="creator-heading"><text class="section-title">创建待办</text><button class="ui-control text-action" bindtap="toggleTemplates" aria-expanded="{{templatesOpen}}" hover-class="ui-press-text">{{templatesOpen ? '收起模板' : '使用模板'}}<lp-icon name="{{templatesOpen ? 'line-down' : 'line-right'}}" size="32rpx" color="#b72f46" /></button></view>
        <scroll-view wx:if="{{templatesOpen}}" scroll-x enhanced class="template-scroll" show-scrollbar="{{false}}">
          <view class="template-row">
            <button wx:for="{{taskPresets}}" wx:key="id" class="ui-control template-card {{selectedTaskPreset === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="useTaskPreset" aria-pressed="{{selectedTaskPreset === item.id}}" hover-class="ui-press">
              <lp-icon name="{{item.icon}}" size="34rpx" color="#493d38" /><text class="template-title">{{item.title}}</text><text class="template-meta">+{{item.points}} 积分</text>
            </button>
          </view>
        </scroll-view>
        <text class="field-hint">待办类型</text>
        <view class="segment task-kind-segment"><view class="segment-item {{taskKind === 'one_time' ? 'active' : ''}}" data-kind="one_time" bind:tap="selectTaskKind">单次</view><view class="segment-item {{taskKind === 'recurring' ? 'active' : ''}}" data-kind="recurring" bind:tap="selectTaskKind">重复</view><view class="segment-item {{taskKind === 'project' ? 'active' : ''}} {{state.activeSpaceType !== 'couple' ? 'disabled' : ''}}" data-kind="project" bind:tap="selectTaskKind">大计划</view></view>
        <view class="create-field"><text class="field-hint">待办名称</text><input aria-label="标题" class="text-input" maxlength="60" value="{{title}}" bind:input="handleTitle" /></view>

        <view class="create-field"><text class="field-hint">完成奖励</text><input aria-label="奖励积分" class="text-input" type="number" value="{{points}}" bind:input="handlePoints" /><text class="input-suffix">积分</text></view>
        <block wx:if="{{taskKind === 'recurring'}}"><text class="field-hint section-gap">重复周期</text><view class="segment"><view class="segment-item {{planType === 'daily' ? 'active' : ''}}" data-plan="daily" bind:tap="selectPlanType">每日</view><view class="segment-item {{planType === 'weekly' ? 'active' : ''}}" data-plan="weekly" bind:tap="selectPlanType">每周</view></view></block>
        <block wx:if="{{taskKind !== 'project'}}">
<block wx:if="{{state.activeSpaceType === 'couple'}}"><text class="field-hint section-gap">由谁完成</text><view class="segment assignee-three"><view class="segment-item {{assignee === 'self' ? 'active' : ''}}" data-assignee="self" bind:tap="selectAssignee">我来完成</view><view class="segment-item {{assignee === 'partner' ? 'active' : ''}}" data-assignee="partner" bind:tap="selectAssignee">TA 来完成</view><view class="segment-item {{assignee === 'both' ? 'active' : ''}}" data-assignee="both" bind:tap="selectAssignee">双方都做</view></view></block>
          <view class="options-toggle" bind:tap="toggleMoreOptions">{{moreOptionsOpen ? '收起设置' : '更多设置'}}<text class="options-summary">{{completionRequirement === 'image' ? '需照片' : completionRequirement === 'note' ? '需说明' : '直接完成'}}{{approvalRequired ? ' · 需确认' : ''}}</text></view>
          <view wx:if="{{moreOptionsOpen}}"><view class="create-field"><text class="field-hint">简短说明</text><input aria-label="说明" class="text-input" maxlength="200" value="{{description}}" bind:input="handleDescription" /></view>          <text class="field-hint section-gap">完成方式</text>
          <view class="choice-wrap"><view class="choice-chip {{completionRequirement === 'direct' ? 'active' : ''}}" data-requirement="direct" bind:tap="selectCompletionRequirement">直接完成</view><view class="choice-chip {{completionRequirement === 'note' ? 'active' : ''}}" data-requirement="note" bind:tap="selectCompletionRequirement">填写说明</view><view class="choice-chip {{completionRequirement === 'image' ? 'active' : ''}}" data-requirement="image" bind:tap="selectCompletionRequirement">上传图片</view></view>
          <block wx:if="{{state.activeSpaceType === 'couple'}}"><text class="field-hint section-gap">完成后</text><view class="segment"><view class="segment-item {{!approvalRequired ? 'active' : ''}}" data-approval="false" bind:tap="toggleApproval">完成即到账</view><view class="segment-item {{approvalRequired ? 'active' : ''}}" data-approval="true" bind:tap="toggleApproval">需要确认</view></view></block>
</view>
        </block>
        <block wx:else>
          <view class="create-field"><text class="field-hint">简短说明</text><input aria-label="说明" class="text-input" maxlength="200" value="{{description}}" bind:input="handleDescription" /></view>

          <view wx:for="{{projectSteps}}" wx:key="index" class="project-step-editor">
            <view class="section-heading"><text class="section-title">环节 {{index + 1}}</text><text class="remove-step" data-index="{{index}}" bind:tap="removeProjectStep">移除</text></view>
            <input aria-label="环节名称" class="text-input step-title-input" maxlength="60" placeholder="例如：购买车票" value="{{item.title}}" data-index="{{index}}" bind:input="handleProjectStepTitle" />
            <view class="segment compact"><view class="segment-item {{item.assignee === 'self' ? 'active' : ''}}" data-index="{{index}}" data-assignee="self" bind:tap="selectProjectStepAssignee">我完成</view><view class="segment-item {{item.assignee === 'partner' ? 'active' : ''}}" data-index="{{index}}" data-assignee="partner" bind:tap="selectProjectStepAssignee">TA 完成</view></view>
            <view class="choice-wrap compact"><view class="choice-chip {{item.completionRequirement === 'direct' ? 'active' : ''}}" data-index="{{index}}" data-requirement="direct" bind:tap="selectProjectStepRequirement">直接完成</view><view class="choice-chip {{item.completionRequirement === 'note' ? 'active' : ''}}" data-index="{{index}}" data-requirement="note" bind:tap="selectProjectStepRequirement">说明</view><view class="choice-chip {{item.completionRequirement === 'image' ? 'active' : ''}}" data-index="{{index}}" data-requirement="image" bind:tap="selectProjectStepRequirement">图片</view></view>
          </view>
          <view class="soft-button add-step" bind:tap="addProjectStep">＋ 添加环节</view>
        </block>
        <button class="ui-control ui-primary task-submit {{busy || !title || !points ? 'is-disabled' : ''}}" disabled="{{busy || !title || !points}}" loading="{{busy}}" hover-class="ui-primary-pressed" bindtap="createTask">创建{{taskKind === 'project' ? '大计划' : '待办'}}</button>
      </view>

      <view wx:if="{{!createOpen && todayTotal}}" class="today-progress" aria-label="今日完成 {{todayCompleted}} 项，共 {{todayTotal}} 项">
        <view class="today-progress-copy"><text class="today-progress-title">今日进度</text><text class="today-progress-value ui-number">{{todayCompleted}} / {{todayTotal}}</text></view>
        <view class="today-progress-track"><view class="today-progress-fill" style="width:{{todayPercent}}%;"></view></view>
      </view>
      <view wx:if="{{!createOpen}}" class="task-sections">
        <view wx:for="{{taskSections}}" wx:key="id" class="task-section {{item.id === 'today' ? 'today' : ''}}">
          <button class="ui-control section-toggle" data-id="{{item.id}}" bindtap="toggleTaskSection" aria-expanded="{{item.expanded}}" hover-class="ui-press-text" hover-start-time="20">
            <text class="section-name">{{item.title}}</text><text class="section-count ui-number">{{item.tasks.length}}</text><lp-icon name="{{item.expanded ? 'line-down' : 'line-right'}}" size="32rpx" color="#81716a" />
          </button>
          <view wx:if="{{item.expanded}}" class="section-content">
            <view wx:if="{{item.tasks.length}}" class="ui-group compact-list">
              <view wx:for="{{item.tasks}}" wx:for-item="task" wx:key="id" class="task-entry {{completedId === task.id ? 'is-completing' : ''}}">
                <view class="task-entry-inner">
                  <view class="task-summary">
                    <button wx:if="{{task.canComplete}}" class="ui-control task-check" data-id="{{task.id}}" bindtap="checkTask" hover-class="{{busy ? 'none' : 'ui-press'}}" aria-disabled="{{busy}}" aria-label="{{task.requirementLabel}}，{{task.title}}">
                      <lp-icon wx:if="{{completedId === task.id}}" class="draw-check" name="line-tick" size="46rpx" color="#ffffff" />
                      <lp-icon wx:else name="line-task" size="46rpx" color="#a34b59" />
                    </button>
                    <view wx:else class="task-marker"><lp-icon name="{{task.status === 'done' ? 'line-check' : task.kind === 'project' ? 'line-clipboard' : 'line-clock'}}" size="44rpx" color="#736760" /></view>
                    <button class="ui-control task-summary-body" data-id="{{task.id}}" bindtap="toggleTask" hover-class="{{busy ? 'none' : 'ui-press'}}" aria-disabled="{{busy}}" aria-expanded="{{expandedTaskId === task.id}}">
                      <view class="cell-copy"><text class="cell-title">{{task.title}}</text>
                        <text wx:if="{{task.bothRequired}}" class="cell-subtitle">我{{task.selfCompletion.completed ? '已完成' : '待完成'}} · TA{{task.partnerCompletion.completed ? '已完成' : '待完成'}}</text>
                        <text wx:elif="{{task.status === 'pending' || task.status === 'rejected' || task.status === 'missed'}}" class="cell-subtitle">{{task.statusLabel}}</text>
                        <text wx:elif="{{task.kind === 'project'}}" class="cell-subtitle">已完成 {{task.progressPercent}}%</text>
                        <text wx:elif="{{!task.assigneeIsSelf && task.status !== 'done'}}" class="cell-subtitle">由 TA 完成</text>
                      </view>
                      <text class="todo-points ui-number">{{completedId === task.id ? '已完成' : submittingId === task.id ? '提交中…' : '+' + task.points + (task.bothRequired ? ' / 人' : '')}}</text>
                      <lp-icon wx:if="{{completedId !== task.id}}" name="{{expandedTaskId === task.id ? 'line-down' : 'line-right'}}" size="32rpx" color="#81716a" />
                    </button>
                  </view>
                  <view wx:if="{{expandedTaskId === task.id}}" class="task-inline">
                    <text wx:if="{{task.description}}" class="inline-description">{{task.description}}</text>
                    <text wx:if="{{task.kind !== 'project'}}" class="inline-meta">{{task.bothRequired ? '双方分别完成' : task.assigneeIsSelf ? '由我完成' : '由 TA 完成'}} · {{task.requirementLabel}}{{!task.bothRequired && task.approvalRequired && state.activeSpaceType === 'couple' ? ' · 需对方确认' : ''}}</text>
                    <text wx:if="{{task.rejectionReason}}" class="inline-meta">退回原因 · {{task.rejectionReason}}</text>
                    <block wx:if="{{task.canComplete && task.completionRequirement !== 'direct'}}">
                      <textarea wx:if="{{task.completionRequirement === 'note'}}" class="inline-note" data-id="{{task.id}}" value="{{drafts[task.id].note || ''}}" placeholder="填写完成说明" aria-label="完成说明" maxlength="500" auto-height disabled="{{busy}}" bindinput="inlineNote" />
                      <view wx:else class="inline-photos">
                        <button wx:for="{{drafts[task.id].images}}" wx:for-item="photo" wx:key="localPath" class="ui-control inline-photo" data-id="{{task.id}}" data-index="{{index}}" bindtap="removeInlinePhoto" disabled="{{busy}}" aria-label="移除第 {{index + 1}} 张照片"><image src="{{photo.localPath}}" mode="aspectFill" /><text>×</text></button>
                        <button wx:if="{{!drafts[task.id] || drafts[task.id].images.length < 3}}" class="ui-control inline-add" data-id="{{task.id}}" bindtap="inlinePhoto" disabled="{{busy}}"><lp-icon name="line-plus" size="34rpx" color="#b72f46" />照片</button>
                      </view>
                      <button class="ui-control ui-primary inline-submit" data-id="{{task.id}}" bindtap="submitInline" loading="{{submittingId === task.id}}" disabled="{{busy || (task.completionRequirement === 'note' ? !drafts[task.id].note : !drafts[task.id].images.length)}}" hover-class="ui-primary-pressed">{{task.approvalRequired && !task.bothRequired && state.activeSpaceType === 'couple' ? '提交确认' : '完成待办'}}</button>
                    </block>
                    <button class="ui-control task-detail-link" data-id="{{task.id}}" bindtap="openTask" disabled="{{busy}}" hover-class="ui-press-text">{{task.status === 'pending' && task.reviewerIsSelf ? '去确认' : '查看详情'}}<lp-icon name="line-right" size="32rpx" color="#b72f46" /></button>
                  </view>
                </view>
              </view>
            </view>
            <view wx:else class="ui-group section-empty"><text>暂无待完成事项</text><button class="ui-control section-empty-action" bindtap="toggleCreate" hover-class="ui-press-text">新建待办</button></view>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view wx:if="{{createOpen}}" class="create-panel creator-card">
        <view class="creator-heading"><view><text class="section-title">创建心愿</text></view><text wx:if="{{selectedRewardPreset}}" class="template-selected">已套用模板</text></view>
        <scroll-view scroll-x enhanced class="template-scroll" show-scrollbar="{{false}}"><view class="template-row"><button wx:for="{{rewardPresets}}" wx:key="id" class="ui-control template-card {{selectedRewardPreset === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="useRewardPreset" aria-pressed="{{selectedRewardPreset === item.id}}" hover-class="ui-press"><lp-icon name="{{item.icon}}" size="34rpx" color="#493d38" /><text class="template-title">{{item.name}}</text><text class="template-meta">{{item.cost}} 积分</text></button></view></scroll-view>
        <view class="create-field"><text class="field-hint">心愿名称</text><input aria-label="心愿名称" class="text-input" value="{{rewardName}}" bind:input="handleRewardName" /></view><view class="create-field"><text class="field-hint">简短说明</text><input aria-label="心愿说明" class="text-input" value="{{rewardDescription}}" bind:input="handleRewardDescription" /></view><view class="create-field"><text class="field-hint">所需积分</text><input aria-label="兑换积分" class="text-input" type="number" value="{{rewardCost}}" bind:input="handleRewardCost" /></view><view class="create-field"><text class="field-hint">有效期</text><input aria-label="有效期" class="text-input" maxlength="60" value="{{rewardExpiry}}" bind:input="handleRewardExpiry" /></view><view class="create-field"><text class="field-hint">使用约定</text><input aria-label="使用约定" class="text-input" maxlength="120" value="{{rewardCondition}}" bind:input="handleRewardCondition" /></view>
        <block wx:if="{{state.activeSpaceType === 'couple'}}"><text class="field-hint">心愿给谁</text><view class="choice-wrap"><view class="choice-chip {{rewardBeneficiaryType === 'self' ? 'active' : ''}}" data-beneficiary="self" bind:tap="selectRewardBeneficiary">给我</view><view class="choice-chip {{rewardBeneficiaryType === 'partner' ? 'active' : ''}}" data-beneficiary="partner" bind:tap="selectRewardBeneficiary">给 TA</view><view class="choice-chip {{rewardBeneficiaryType === 'couple' ? 'active' : ''}}" data-beneficiary="couple" bind:tap="selectRewardBeneficiary">两人共同</view></view></block>
        <view wx:if="{{state.activeSpaceType === 'couple'}}" class="switch-row"><view><text class="cell-title">兑换前需要对方同意</text></view><switch color="#f65f6b" checked="{{rewardApprovalRequired}}" bind:change="handleRewardApproval" /></view>
        <button class="ui-control ui-primary task-submit {{busy || !rewardName || !rewardCost ? 'is-disabled' : ''}}" disabled="{{busy || !rewardName || !rewardCost}}" loading="{{busy}}" hover-class="ui-primary-pressed" bindtap="createReward">创建心愿</button>
      </view>
      <view class="notice-card brand store-balance"><text class="notice-title">{{state.activeSpaceType === 'couple' ? '情侣积分 ' + state.sharedPoints : '个人积分 ' + state.personalPoints}}</text></view>
      <scroll-view scroll-x enhanced class="plan-filter-scroll" show-scrollbar="{{false}}"><view class="plan-filters"><view class="plan-filter {{rewardFilter === 'all' ? 'active' : ''}}" data-filter="all" bind:tap="selectRewardFilter">全部</view><view class="plan-filter {{rewardFilter === 'available' ? 'active' : ''}}" data-filter="available" bind:tap="selectRewardFilter">可兑换</view><view class="plan-filter {{rewardFilter === 'purchased' ? 'active' : ''}}" data-filter="purchased" bind:tap="selectRewardFilter">已兑换</view><view class="plan-filter {{rewardFilter === 'pending' ? 'active' : ''}}" data-filter="pending" bind:tap="selectRewardFilter">待确认</view><view class="plan-filter {{rewardFilter === 'refund' ? 'active' : ''}}" data-filter="refund" bind:tap="selectRewardFilter">退款中</view></view></scroll-view>
      <view wx:if="{{rewards.length}}" class="ui-group reward-list"><button wx:for="{{rewards}}" wx:key="id" class="ui-control todo-row reward-row" data-id="{{item.id}}" hover-class="ui-press" hover-start-time="20" bindtap="openReward"><lp-icon name="line-gift" size="46rpx" color="#b72f46" /><view class="cell-copy"><text class="cell-title">{{item.name}}</text><text wx:if="{{item.description}}" class="cell-subtitle">{{item.description}}</text><text class="cell-subtitle">{{item.cost}} {{item.pointsLabel}}积分 · {{item.beneficiaryType === 'couple' ? '两人共同' : item.beneficiaryType === 'partner' ? '给 TA' : '给我'}}</text></view><text class="todo-status">{{item.statusLabel}}</text><lp-icon name="line-right" size="32rpx" color="#81716a" /></button></view>
      <view wx:else class="empty-state"><text class="empty-title">{{rewardFilter === 'all' ? '还没有心愿' : '没有符合条件的心愿'}}</text></view>
    </block>
  </block>
</view>
