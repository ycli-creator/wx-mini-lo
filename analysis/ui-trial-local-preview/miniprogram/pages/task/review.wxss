.review-heading{padding:24rpx 0}.review-title{display:block;font-size:40rpx;line-height:1.4;font-weight:700}.review-meta{display:block;margin-top:16rpx;color:#6d605b;font-size: var(--lp-type-meta)}.review-note{display:block;margin:16rpx 0 24rpx;font-size: var(--lp-type-meta);line-height:1.6;white-space:pre-wrap}.review-evidence{margin:16rpx 0 32rpx;display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.review-evidence image{width:100%;height:200rpx;border-radius:var(--lp-radius-control)}.review-text-action{min-height:88rpx;display:flex;align-items:center;justify-content:center;color:#8c3d46;font-size: var(--lp-type-meta)}.rejection-form{margin-top:20rpx}
