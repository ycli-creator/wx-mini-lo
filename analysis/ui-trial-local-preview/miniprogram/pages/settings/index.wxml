<page-meta root-font-size="system" />
<view class="screen settings-screen">
  <lp-header title="设置" />
  <lp-page-state wx:if="{{loading || loadError}}" loading="{{loading}}" loading-text="正在同步关系空间" error-text="关系空间暂时没有同步成功，请重新加载。" bind:retry="refresh" />
  <block wx:else>

  <view class="section-heading"><text class="section-title">使用偏好</text></view>
  <view class="segment"><view class="segment-item {{state.preferences.usageMode === 'record' ? 'active' : ''}}" data-mode="record" bind:tap="changeUsageMode">专注记录</view><view class="segment-item {{state.preferences.usageMode === 'social' ? 'active' : ''}}" data-mode="social" bind:tap="changeUsageMode">分享生活</view></view>
  <view class="section-heading"><text class="section-title">主页隐私</text></view>
  <view class="surface-group">
    <label class="switch-row privacy-master"><text class="cell-title">一键不展示</text><switch aria-label="一键不展示" disabled="{{busy}}" data-key="privateMode" checked="{{state.profile.privacy.privateMode}}" color="#c83d53" bind:change="changePrivacy" /></label>
    <block wx:for="{{privacyOptions}}" wx:key="key">
      <label wx:if="{{!item.couple || state.bound}}" class="switch-row {{state.profile.privacy.privateMode ? 'privacy-locked' : ''}}">
        <text class="cell-title">{{item.label}}</text>
        <switch aria-label="{{item.label}}" data-key="{{item.key}}" disabled="{{busy || state.profile.privacy.privateMode}}" checked="{{!state.profile.privacy.privateMode && state.profile.privacy[item.key]}}" color="#c83d53" bind:change="changePrivacy" />
      </label>
    </block>
  </view>
  <view class="section-heading"><text class="section-title">应用设置</text></view>
  <view class="surface-group">
    <view class="list-cell" hover-class="pressed" bind:tap="openRelationship"><view class="cell-icon"><lp-icon name="heart" size="30rpx" /></view><view class="cell-copy"><text class="cell-title">情侣关系设置</text></view><lp-icon name="line-right" size="32rpx" color="#81716a" /></view>
    <view class="list-cell" hover-class="pressed" bind:tap="openFriends"><view class="cell-icon"><lp-icon name="usergroup-add" size="30rpx" /></view><view class="cell-copy"><text class="cell-title">好友与身份码</text></view><lp-icon name="line-right" size="32rpx" color="#81716a" /></view>
    <view class="list-cell" hover-class="pressed" bind:tap="openPolicies"><view class="cell-icon"><lp-icon name="file-paste" size="30rpx" /></view><view class="cell-copy"><text class="cell-title">协议、隐私与社区规范</text></view><lp-icon name="line-right" size="32rpx" color="#81716a" /></view>
    <view class="list-cell"><view class="cell-icon"><lp-icon name="info-circle" size="30rpx" /></view><view class="cell-copy"><text class="cell-title">关于 Love Points</text></view><text class="cell-value">v{{appVersion}}</text></view>
    <view wx:if="{{state.bound}}" class="list-cell danger-row" hover-class="pressed" bind:tap="openUnbind"><view class="cell-icon"><lp-icon name="error-circle" size="30rpx" /></view><view class="cell-copy"><text class="cell-title">解除绑定</text></view><lp-icon name="line-right" size="32rpx" color="#81716a" /></view>
  </view>
  </block>
</view>
