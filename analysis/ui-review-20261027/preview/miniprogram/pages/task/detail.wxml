<view class="screen task-detail-screen">
  <lp-header title="{{task.kind === 'project' ? '大计划' : '待办详情'}}" />
  <lp-page-state wx:if="{{loading || loadError}}" loading="{{loading}}" loading-text="正在读取待办" error-text="待办暂时无法读取，请重试。" bind:retry="refresh" />
  <block wx:else>
    <view class="task-heading"><text class="task-title">{{task.title}}</text><view class="task-meta"><text>{{task.bothRequired ? '每人 ' : ''}}+{{task.points}} 积分</text><text>{{task.bothRequired ? '我' + (task.selfCompletion.completed ? '已完成' : '待完成') + ' · TA' + (task.partnerCompletion.completed ? '已完成' : '待完成') : task.status === 'done' ? '已完成' : task.status === 'pending' ? '待确认' : task.status === 'rejected' ? '待补充' : task.assigneeIsSelf ? '我来完成' : 'TA 来完成'}}</text></view></view>
    <view wx:if="{{task.status === 'rejected'}}" class="notice-card warning"><text>{{task.rejectionReason || '请补充后重新提交'}}</text></view>
    <view wx:if="{{canComplete}}" class="task-workspace">
<view wx:if="{{images.length}}" class="evidence-grid"><view wx:for="{{images}}" wx:key="localPath" class="draft-photo"><image src="{{item.localPath}}" mode="aspectFill" data-url="{{item.localPath}}" bind:tap="previewImage"/><view class="photo-remove" data-index="{{index}}" catch:tap="removeImage" aria-role="button" aria-label="移除照片"><lp-icon name="close" size="28rpx"/></view></view></view>
      <view wx:if="{{images.length < 3}}" class="photo-upload prominent" bind:tap="chooseImage" aria-role="button" aria-label="上传照片"><lp-icon name="camera" size="64rpx"/><text>{{images.length ? '继续添加照片' : '上传照片'}}</text></view>
      <textarea wx:if="{{task.completionRequirement === 'note' || optionalNoteOpen}}" class="text-area completion-note" maxlength="300" placeholder="{{task.completionRequirement === 'note' ? '完成说明（必填）' : '添加说明'}}" value="{{note}}" bind:input="handleNote" />
      <view wx:if="{{task.completionRequirement !== 'note'}}" class="text-action" bind:tap="toggleOptionalNote">{{optionalNoteOpen ? '收起说明' : '添加说明'}}</view>
      <lp-button label="{{needsApproval ? '提交确认' : '完成待办'}}" loading="{{busy}}" disabled="{{task.completionRequirement === 'image' && !images.length || task.completionRequirement === 'note' && !note}}" bind:tap="completeTask" />
    </view>
    <block wx:if="{{task.kind === 'project'}}">
      <view class="section-heading"><text class="section-title">计划环节</text><text class="section-caption">每个环节奖励 10%</text></view>
      <view class="project-step-list">
        <view wx:for="{{task.projectSteps}}" wx:key="id" class="project-step-card">
          <view class="project-step {{item.status === 'done' ? 'done' : ''}}" data-id="{{item.id}}" bind:tap="selectStep"><view class="step-status"><lp-icon name="{{item.status === 'done' ? 'check-circle-filled' : 'circle'}}" size="34rpx" /></view><view class="cell-copy"><text class="cell-title">{{item.title}}</text><text class="cell-subtitle">{{item.assigneeIsSelf ? '由我完成' : '由 TA 完成'}} · {{item.completionRequirement === 'image' ? '需上传图片' : item.completionRequirement === 'note' ? '需填写说明' : '直接完成'}} · +{{item.rewardPoints}}</text></view><text wx:if="{{item.status !== 'done'}}" class="chevron">›</text></view>
          <view wx:if="{{item.note}}" class="step-note">{{item.note}}</view>
          <view wx:if="{{item.evidence.length || item.media.length}}" class="step-media"><image wx:for="{{item.evidence}}" wx:for-item="photo" wx:key="fileId" src="{{photo.fileId}}" mode="aspectFill"/><image wx:for="{{item.media}}" wx:for-item="photo" wx:key="fileId" src="{{photo.fileId}}" mode="aspectFill"/></view>
          <view class="step-photo-action" data-step-id="{{item.id}}" catch:tap="addGalleryPhotos"><lp-icon name="camera" size="26rpx"/><text>补充照片</text></view>
        </view>
      </view>
      <view wx:if="{{activeStepId}}" id="step-completion" class="step-completion"><view class="section-heading"><text class="section-title">完成环节</text><view class="text-action" bind:tap="closeStep">取消</view></view>
        <textarea wx:if="{{activeStepRequirement === 'note' || optionalNoteOpen}}" class="text-area" maxlength="300" placeholder="完成说明" value="{{note}}" bind:input="handleNote" />
<view wx:if="{{images.length}}" class="evidence-grid"><view wx:for="{{images}}" wx:key="localPath" class="draft-photo"><image src="{{item.localPath}}" mode="aspectFill" data-url="{{item.localPath}}" bind:tap="previewImage"/><view class="photo-remove" data-index="{{index}}" catch:tap="removeImage" aria-role="button" aria-label="移除照片"><lp-icon name="close" size="28rpx"/></view></view></view>
        <view wx:if="{{images.length < 3}}" class="photo-upload {{activeStepRequirement === 'image' ? 'prominent' : ''}}" bind:tap="chooseImage" aria-role="button" aria-label="上传照片"><lp-icon name="camera" size="48rpx"/><text>{{images.length ? '继续添加' : '上传照片'}}</text></view>
        <view wx:if="{{activeStepRequirement !== 'note'}}" class="text-action" bind:tap="toggleOptionalNote">{{optionalNoteOpen ? '收起说明' : '添加说明'}}</view>
        <lp-button label="完成环节" loading="{{busy}}" disabled="{{activeStepRequirement === 'image' && !images.length || activeStepRequirement === 'note' && !note}}" bind:tap="completeStep"/>
      </view>
      <lp-button wx:if="{{allStepsDone && !task.projectFinalized}}" label="完成计划" loading="{{busy}}" bind:tap="completeProject" />
      <view wx:if="{{task.projectFinalized}}" class="notice-card success"><text class="notice-title">共同计划已经完成</text></view>
    </block>

    <block wx:if="{{!canComplete && task.kind !== 'project'}}">
      <view wx:if="{{task.latestNote || task.evidence.length}}" class="completion-record"><text wx:if="{{task.latestNote}}" class="record-note">{{task.latestNote}}</text><view class="gallery-grid"><image wx:for="{{task.evidence}}" wx:key="fileId" src="{{item.fileId}}" mode="aspectFill" data-url="{{item.fileId}}" bind:tap="previewImage"/></view></view>
      <lp-button wx:if="{{task.status === 'pending' && task.reviewerIsSelf}}" label="确认完成" bind:tap="openTaskAction" />
      <view wx:if="{{task.status !== 'done'}}" class="shared-photos"><view wx:if="{{task.media.length}}" class="gallery-grid"><image wx:for="{{task.media}}" wx:key="fileId" src="{{item.fileId}}" mode="aspectFill" data-url="{{item.fileId}}" bind:tap="previewImage"/></view><view class="photo-upload prominent" bind:tap="addGalleryPhotos" aria-role="button" aria-label="添加照片"><lp-icon name="camera" size="64rpx"/><text>{{busy ? '正在上传…' : '添加照片'}}</text></view></view>
    </block>
    <view class="detail-tools"><view class="text-action" bind:tap="toggleDetails">{{detailsOpen ? '收起详情' : '待办详情'}}<lp-icon name="arrow-down-2" size="26rpx"/></view><view class="text-action" bind:tap="toggleEdit">{{editOpen ? '取消编辑' : '编辑'}}</view><view wx:if="{{!task.assigneeIsSelf || task.kind === 'project' || task.bothRequired && !task.partnerCompletion.completed}}" class="text-action" bind:tap="cuePartner">@TA 提醒</view></view>
    <view wx:if="{{editOpen}}" class="edit-panel">
      <view class="section-heading"><text class="section-title">编辑待办</text></view>
      <text class="field-hint">待办名称</text><input class="text-input edit-input" maxlength="60" value="{{editTitle}}" bind:input="handleEditTitle" />
      <text class="field-hint">说明</text><textarea class="text-area edit-area" maxlength="200" value="{{editDescription}}" bind:input="handleEditDescription" />
      <text class="field-hint">{{task.bothRequired ? '每人积分' : '完成积分'}}</text><input class="text-input edit-input" type="number" value="{{editPoints}}" bind:input="handleEditPoints" />
      <block wx:if="{{task.kind !== 'project'}}"><text class="field-hint">完成方式</text><view class="choice-wrap"><view class="choice-chip {{editRequirement === 'direct' ? 'active' : ''}}" data-requirement="direct" bind:tap="selectEditRequirement">直接完成</view><view class="choice-chip {{editRequirement === 'note' ? 'active' : ''}}" data-requirement="note" bind:tap="selectEditRequirement">填写说明</view><view class="choice-chip {{editRequirement === 'image' ? 'active' : ''}}" data-requirement="image" bind:tap="selectEditRequirement">上传图片</view></view></block>
      <lp-button label="保存修改" disabled="{{!editTitle || !editPoints}}" loading="{{busy}}" bind:tap="saveEdit" />
    </view>
    <view wx:if="{{detailsOpen}}" class="task-details">
      <text wx:if="{{task.description}}" class="record-note">{{task.description}}</text>
      <view class="data-row"><text>负责人</text><text>{{task.bothRequired ? '双方' : task.assigneeIsSelf ? '我' : 'TA'}}</text></view>
      <view class="data-row"><text>完成方式</text><text>{{task.completionRequirement === 'image' ? '上传照片' : task.completionRequirement === 'note' ? '填写说明' : '直接完成'}}</text></view>
      <view class="data-row"><text>重复</text><text>{{task.planType === 'daily' ? '每天' : task.planType === 'weekly' ? '每周' : '不重复'}}</text></view>
      <view wx:if="{{task.kind !== 'project'}}" class="data-row"><text>本期</text><text>{{task.cycleLabel}}</text></view>
      <view wx:if="{{task.media.length && (canComplete || task.status === 'done' || task.kind === 'project')}}" class="gallery-grid"><image wx:for="{{task.media}}" wx:key="fileId" src="{{item.fileId}}" mode="aspectFill" data-url="{{item.fileId}}" bind:tap="previewImage"/></view>
      <view wx:if="{{canComplete || task.status === 'done' || task.kind === 'project'}}" class="text-action" bind:tap="addGalleryPhotos">补充照片</view>
    <view wx:if="{{task.bothRequired && task.planType === 'daily'}}" class="daily-calendar-card">
      <view class="section-heading calendar-heading"><view><text class="section-title">每日完成日历</text></view><view class="calendar-legend"><text class="legend self">我</text><text class="legend partner">TA</text></view></view>
      <view class="weekday-row"><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text></view>
      <view class="calendar-grid"><view wx:for="{{calendarCells}}" wx:key="date" class="calendar-cell {{item.isToday ? 'today' : ''}}"><text class="calendar-month">{{item.month}}</text><text class="calendar-day">{{item.day}}</text><view class="calendar-marks"><view class="mark self {{item.selfCompleted ? 'filled' : ''}}"></view><view class="mark partner {{item.partnerCompleted ? 'filled' : ''}}"></view></view></view></view>
    </view>
      <view class="section-heading"><text class="section-title">操作记录</text></view><view wx:if="{{logs.length}}" class="activity-list"><view wx:for="{{logs}}" wx:key="id" class="activity-item"><view class="cell-copy"><text class="cell-title">{{item.actorName}} · {{item.summary}}</text><text class="cell-subtitle">{{item.timeLabel}}</text></view></view></view><view wx:else class="section-empty">暂无记录</view>
    </view>
  </block>
</view>
