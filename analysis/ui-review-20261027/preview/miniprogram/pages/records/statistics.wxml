<view class="statistics-screen" style="padding-top: {{navTop + 84}}px;">
  <view class="statistics-nav" style="padding-top: {{navTop}}px;">
    <view class="statistics-nav-row"><button class="back-button" bindtap="back" aria-label="返回生活日历"><lp-icon name="arrow-left-2" size="42rpx" /></button><view class="statistics-tabs"><button wx:for="{{tabs}}" wx:key="id" class="{{tab === item.id ? 'active' : ''}}" data-tab="{{item.id}}" bindtap="changeTab">{{item.label}}<view wx:if="{{tab === item.id}}" class="tab-line"></view></button></view><button class="history-button" bindtap="toggleHistory" aria-label="查看记录历史"><lp-icon name="history" size="40rpx" /></button></view>
  </view>
  <lp-page-state wx:if="{{loading || loadError}}" loading="{{loading}}" loading-text="正在读取统计" error-text="健康统计暂时无法读取，请重试。" bind:retry="refresh" />
  <block wx:else>
    <block wx:if="{{tab === 'cycle'}}">
      <view class="summary-card cycle-card">
        <button class="help-button" bindtap="explainCycles" aria-label="查看周期统计口径"><lp-icon name="information" size="25rpx" /></button>
        <view class="cycle-totals"><view><text>{{cycles.total}}</text><text>累计记录周期</text></view><view><text>{{cycles.cycleDifferences}}</text><text>周期长度偏差</text></view><view><text>{{cycles.periodDifferences}}</text><text>经期天数偏差</text></view></view>
        <view class="ticket-divider"></view>
        <view class="cycle-ratio"><text>不同</text><view class="ratio-track"><view style="width: {{cycles.differencePercent}}%;"></view><text>{{cycles.differencePercent}}%</text><text>{{cycles.matchPercent}}%</text></view><text>符合设置</text></view>
      </view>
      <button class="chart-caption" bindtap="explainCycles">周期<lp-icon name="arrow-right-2" size="22rpx" /></button>
      <view wx:if="{{cycles.rows.length}}" class="cycle-chart"><view class="cycle-reference"><text>{{snapshot.profile.settings.cycleLength}}</text></view><button wx:for="{{cycles.rows}}" wx:key="id" class="cycle-chart-row" data-date="{{item.start}}" bindtap="openDate"><text class="cycle-date">{{item.date}}</text><view class="cycle-bars"><view class="cycle-track"><view class="cycle-bar {{item.estimated ? 'estimated' : ''}}" style="width: {{item.width}}%;"><text>{{item.estimated ? '' : item.length}}</text></view><text wx:if="{{item.estimated}}" class="estimated-label">预计{{item.length}}</text></view><view class="period-dots"><view wx:for="{{item.dots}}" wx:key="*this" wx:for-item="dot"></view></view></view></button></view>
      <view wx:else class="statistics-empty">记录经期开始与结束后，会在这里看到周期变化。</view>
      <text class="statistics-note">偏差仅表示与个人设置不同；预计值不计入周期长度偏差。</text>
    </block>
    <block wx:elif="{{tab === 'mood'}}">
      <view class="summary-card mood-card"><view class="profile-summary"><view><text class="profile-name">{{nickname}}</text><text class="secondary">累计记录心情次数 {{snapshot.totalMoodCount}} 次</text></view><view class="profile-avatar"><image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" /><lp-icon wx:else name="profile" size="80rpx" color="#66c7d8" /><view class="avatar-mood"><lp-icon name="happy" size="38rpx" color="#efc64e" /></view></view></view><view class="ticket-divider"></view><view class="mood-rings"><view wx:for="{{moodView.rings}}" wx:key="label" class="mood-ring-item"><view class="mood-ring" style="background: conic-gradient(#8ed6ef {{item.angle}}deg, #f8f8f8 0deg);"><view><text>{{item.percent}}%</text></view></view><view class="ring-face"><lp-icon name="{{item.icon}}" size="45rpx" color="#e9bd35" /></view><text class="ring-label">{{item.label}}</text></view></view></view>
      <view class="heatmap-heading"><picker range="{{yearOptions}}" value="{{yearIndex}}" bindchange="changeYear"><view>{{year}}<lp-icon name="down" size="24rpx" /></view></picker><view class="heatmap-legend"><view><view class="heatmap-sample"></view>平均心情</view><view><view class="heatmap-sample period"></view>经期</view></view></view>
      <view class="heatmap"><view class="heatmap-weekdays"><text>日</text><text>二</text><text>四</text><text>六</text></view><scroll-view class="heatmap-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}"><view class="heatmap-columns"><view wx:for="{{moodView.weeks}}" wx:key="key" class="heatmap-week"><text class="heatmap-month">{{item.month}}</text><button wx:for="{{item.cells}}" wx:for-item="cell" wx:key="date" data-date="{{cell.date}}" bindtap="openDate" aria-label="{{cell.label}}" class="heatmap-cell {{cell.period ? 'is-period' : ''}} {{cell.visible ? '' : 'invisible'}}" style="background: {{cell.color}};"></button></view></view></scroll-view></view>
      <text class="statistics-note">日记与这里共用当天心情 · 左右滑动查看全年</text>
    </block>
    <block wx:else>
      <view class="summary-card habit-card"><view><text class="secondary">累计记录好习惯</text><text class="habit-total">{{snapshot.totalHabitDays}}<text>天</text></text></view><view class="habit-profile"><image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" /><lp-icon wx:else name="profile" size="86rpx" color="#66c7d8" /><text>{{nickname}}</text></view><text class="habit-start secondary">{{snapshot.firstHabitDate ? snapshot.firstHabitDate + ' 开始记录' : '从今天开始，慢慢养成好习惯'}}</text><view class="habit-card-wave"></view></view>
      <view class="habits-heading"><picker range="{{habitRanges}}" value="{{habitRange}}" bindchange="changeHabitRange"><view>{{habitRanges[habitRange]}}<lp-icon name="down" size="25rpx" /></view></picker><text>天</text></view>
      <view class="habit-stat-rows"><view wx:for="{{habitRows}}" wx:key="label" class="habit-stat-row"><lp-icon name="{{item.icon}}" size="42rpx" color="{{item.color}}" /><text class="habit-stat-label">{{item.label}}</text><view class="habit-marks {{habitRange ? 'thirty-days' : ''}}"><view wx:for="{{item.marks}}" wx:for-item="mark" wx:key="date" class="{{mark.checked ? 'checked' : ''}}" style="{{mark.checked ? 'background:' + item.color : ''}}" aria-label="{{mark.date}} {{mark.checked ? '已打卡' : '未打卡'}}"></view></view><text class="habit-stat-count">{{item.count}}</text></view></view>
      <text class="statistics-note">每天完成任一习惯，累计记录天数增加一天。</text>
    </block>
  </block>
  <view wx:if="{{historyOpen}}" class="history-scrim" bindtap="toggleHistory"><view class="history-panel" catchtap="noop"><view class="history-title"><text>{{tab === 'cycle' ? '周期历史' : tab === 'mood' ? '心情历史' : '好习惯历史'}}</text><button bindtap="toggleHistory">关闭</button></view><scroll-view scroll-y="{{true}}"><button wx:for="{{historyRows}}" wx:key="date" class="history-row" data-date="{{item.date}}" bindtap="openDate"><text>{{item.date}}</text><text>{{item.text}}</text><lp-icon name="arrow-right-2" size="25rpx" /></button><text wx:if="{{!historyRows.length}}" class="statistics-empty">还没有记录</text></scroll-view></view></view>
</view>
