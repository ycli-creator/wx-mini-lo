.calendar-page { position: fixed; top: 0; left: 0; right: 0; bottom: 0; width: 100%; height: 100vh; background: var(--lp-bg-canvas); }
.calendar-header { position: absolute; top: 0; left: 0; right: 0; z-index: 30; background: var(--lp-bg-canvas); }.calendar-nav { display: flex; align-items: center; height: 54px; padding: 0 25rpx; gap: 36rpx; }.calendar-nav button { display: flex; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; margin: 0; padding: 14rpx; background: transparent; }.calendar-nav image { width: 38rpx; height: 38rpx; opacity: .7; }.calendar-year { font-size: 37rpx; }.calendar-year text { padding-left: 16rpx; color: var(--lp-text-secondary); }.calendar-spacer { flex: 1; }
.year-scroll { position: absolute; left: 0; right: 0; bottom: 0; height: auto; }.year-month { padding: 42rpx 32rpx 68rpx; }.month-heading { display: flex; position: relative; align-items: center; justify-content: center; min-height: 80rpx; }.month-heading > text { font-size: 60rpx; font-weight: 400; letter-spacing: 4rpx; }.month-heading button { position: absolute; right: 12rpx; top: 10rpx; margin: 0; padding: 10rpx; font-size: 26rpx; color: var(--lp-text-secondary); background: transparent; }.month-count { display: block; margin: 6rpx 0 32rpx; text-align: center; font-size: 25rpx; color: var(--lp-text-secondary); }
.month-week, .month-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 12rpx; }.month-week { padding: 4rpx 0 26rpx; text-align: center; color: var(--lp-text-secondary); font-size: 24rpx; }.month-grid { row-gap: 14rpx; }.calendar-cell-wrap { height: 84rpx; }.calendar-cell { position: relative; width: 100%; height: 84rpx; margin: 0; padding: 0; border-radius: 16rpx; background: var(--lp-disabled); color: var(--lp-brand-text); display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.4; }.calendar-cell.has-record { background: var(--lp-brand); color: #fff; }.calendar-cell.is-today { box-shadow: inset 0 0 0 3rpx var(--lp-brand); }.calendar-cell.is-future:not(.has-record) { color: var(--lp-text-secondary); opacity: .35; }.calendar-cell > image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border-radius: 16rpx; }.cell-day { position: relative; z-index: 1; font-size: 29rpx; }.has-photo .cell-day { position: absolute; left: 8rpx; top: 5rpx; color: #fff; font-size: 23rpx; text-shadow: 0 1rpx 5rpx #000; }.cell-detail { position: relative; z-index: 1; font-size: 18rpx; max-width: 100%; overflow: hidden; white-space: nowrap; }.cell-count { position: absolute; bottom: 4rpx; right: 7rpx; font-size: 16rpx; z-index: 2; }.has-photo .cell-count { color: #fff; text-shadow: 0 1rpx 4rpx #000; }
.calendar-modes { position: absolute; left: 50%; bottom: calc(40rpx + env(safe-area-inset-bottom)); transform: translateX(-50%); z-index: 40; display: flex; width: 470rpx; padding: 12rpx; border-radius: 80rpx; background: var(--lp-bg-surface); border: 1rpx solid var(--lp-border); box-shadow: 0 5rpx 22rpx #2f292815; }.calendar-modes button { flex: 1; margin: 0; padding: 14rpx 8rpx; font-size: 30rpx; line-height: 1.6; color: var(--lp-text-primary); background: transparent; border-radius: 60rpx; }.calendar-modes button.active { background: var(--lp-brand); color: #fff; }
.calendar-filter { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 38rpx; border-bottom: 1rpx solid var(--lp-border); font-size: 27rpx; color: var(--lp-brand-text); }.calendar-filter button { padding: 10rpx; margin: 0; background: transparent; color: inherit; font-size: 27rpx; }.calendar-end { height: calc(160rpx + env(safe-area-inset-bottom)); }button::after { border: none; }
.calendar-year, .calendar-filter picker > view, .calendar-filter button { display: flex; align-items: center; gap: 12rpx; }
