.tabbar { position: fixed; z-index: 100; left: 0; right: 0; bottom: 0; padding: 8rpx 16rpx calc(8rpx + env(safe-area-inset-bottom)); display: grid; grid-template-columns: repeat(4, 1fr); background: #fff; border-top: 1rpx solid #eee6e1; }
.item { min-height: 104rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; color: #8e817c; }
.item.active { color: #e84a57; font-weight: 600; }
.pressed { background: #fff1f0; }
.icon-wrap { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; }
.label { font-size: 22rpx; line-height: 30rpx; }
