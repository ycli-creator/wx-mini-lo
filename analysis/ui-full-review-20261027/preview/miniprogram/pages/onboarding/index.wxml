<view class="screen onboarding-screen">
  <lp-header title="选择使用方式" />
  <view class="mode-list">
    <view class="mode-option {{selected === 'record' ? 'selected' : ''}}" data-mode="record" bind:tap="selectMode">
      <view class="mode-icon"><lp-icon name="lock-on" size="42rpx" /></view>
      <view class="mode-copy"><text class="mode-title">专注记录</text></view>
      <view class="mode-check"><lp-icon wx:if="{{selected === 'record'}}" name="check" size="26rpx" /></view>
    </view>
    <view class="mode-option {{selected === 'social' ? 'selected' : ''}}" data-mode="social" bind:tap="selectMode">
      <view class="mode-icon"><lp-icon name="usergroup" size="42rpx" /></view>
      <view class="mode-copy"><text class="mode-title">分享生活</text></view>
      <view class="mode-check"><lp-icon wx:if="{{selected === 'social'}}" name="check" size="26rpx" /></view>
    </view>
  </view>

  <lp-button label="按这个方式开始" loading="{{busy}}" bind:tap="continue" />
</view>
