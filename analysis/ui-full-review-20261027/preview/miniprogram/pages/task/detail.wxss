step-photo-action{min-height:68rpx;display:flex;align-items:center;justify-content:center;gap:8rpx;color:var(--lp-brand-text);background:var(--lp-brand-soft);font-size:21rpx}.completion-record{margin:0 0 24rpx;padding:24rpx 0;border-bottom:1rpx solid var(--lp-border)}.record-note{display:block;margin:10rpx 0 18rpx;color:var(--lp-text-secondary);font-size:24rpx;line-height:40rpx}.daily-calendar-card{margin-top:30rpx;padding:26rpx 0;border-top:1rpx solid var(--lp-border)}.calendar-heading{margin-top:0}.calendar-heading>view:first-child{min-width:0;flex:1}.calendar-legend{display:flex;gap:8rpx}.legend{padding:6rpx 12rpx;border-radius:999rpx;font-size:19rpx}.legend.self{color:#3978ba;background:#e9f3ff}.legend.partner{color:#c64f75;background:#fff0f5}.weekday-row,.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:8rpx}.weekday-row{margin-bottom:8rpx;color:var(--lp-text-secondary);text-align:center;font-size:19rpx}.calendar-cell{position:relative;min-height:86rpx;padding:8rpx 4rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border:2rpx solid transparent;border-radius:var(--lp-radius-control)}.calendar-cell.today{border-color:var(--lp-brand)}.calendar-month{position:absolute;top:3rpx;left:5rpx;color:var(--lp-text-secondary);font-size:14rpx}.calendar-day{font-size:21rpx}.calendar-marks{width:34rpx;height:9rpx;margin-top:7rpx;display:grid;grid-template-columns:1fr 1fr;gap:3rpx}.mark{background:#e4dfde;border-radius:999rpx}.mark.self.filled{background:#6aa6e8}.mark.partner.filled{background:#f18aa8}

