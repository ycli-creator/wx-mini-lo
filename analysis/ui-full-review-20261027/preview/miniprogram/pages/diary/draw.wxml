<view class="screen drawing-screen">
  <lp-header title="手绘" />
  <view class="drawing-paper">
    <canvas type="2d" id="diary-drawing" class="drawing-canvas" disable-scroll="{{true}}" catchtouchstart="beginStroke" catchtouchmove="continueStroke" catchtouchend="endStroke" catchtouchcancel="endStroke" aria-label="手绘画布" />
    <text wx:if="{{ready && !hasDrawing}}" class="drawing-placeholder">在这里画下今天</text>
  </view>
  <view class="drawing-toolbar">
    <view class="drawing-setting">
      <text class="drawing-label">笔色</text>
      <view class="drawing-colors">
        <button wx:for="{{colors}}" wx:key="value" class="drawing-swatch {{color === item.value ? 'selected' : ''}}" data-color="{{item.value}}" bindtap="chooseColor" disabled="{{busy}}" aria-label="{{item.name}}{{color === item.value ? '，已选择' : ''}}"><view style="background: {{item.value}};"></view></button>
      </view>
    </view>
    <view class="drawing-setting">
      <text class="drawing-label">粗细</text>
      <view class="drawing-widths">
        <button wx:for="{{widths}}" wx:key="value" class="drawing-width {{width === item.value ? 'selected' : ''}}" data-width="{{item.value}}" bindtap="chooseWidth" disabled="{{busy}}" aria-label="{{item.name}}笔"><view style="height: {{item.value * 2}}rpx;"></view><text>{{item.name}}</text></button>
      </view>
    </view>
  </view>
  <view wx:if="{{error}}" class="drawing-error" role="alert"><text>{{error}}</text><button wx:if="{{!ready}}" class="drawing-text-button" bindtap="initializeCanvas">重新打开画布</button></view>
  <view class="drawing-actions">
    <button class="drawing-secondary" bindtap="undo" disabled="{{busy || !hasDrawing}}">撤销</button>
    <button class="drawing-secondary" bindtap="clear" disabled="{{busy || !hasDrawing}}">清空</button>
    <button class="drawing-primary" bindtap="save" loading="{{busy}}" disabled="{{busy || !hasDrawing || !ready}}">添加到日记</button>
  </view>
</view>
