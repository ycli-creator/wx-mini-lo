.diary-screen { max-width: 900rpx; margin: 0 auto; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.diary-primary { margin: 0 0 24rpx; background: var(--lp-brand); color: #fff; border-radius: 20rpx; font-size: 30rpx; font-weight: 600; }
button::after { border: none; }
.diary-empty { padding: 72rpx 20rpx; text-align: center; color: var(--lp-text-secondary); font-size: 28rpx; line-height: 1.8; }.diary-empty text { display: block; }
.journal-page { min-height: 100vh; padding-bottom: calc(170rpx + env(safe-area-inset-bottom)); }
.feed-head { position: fixed; top: 0; left: 0; right: 0; z-index: 40; background: var(--lp-brand); color: #fff; }
.journal-nav { height: 54px; display: flex; align-items: center; padding: 0 22rpx; gap: 12rpx; }
.nav-tool { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 76rpx; margin: 0; padding: 12rpx; background: transparent; }
.nav-tool image { width: 38rpx; height: 38rpx; filter: brightness(0) invert(1); }.nav-spacer { flex: 1; }
.journal-date { display: flex; align-items: center; gap: 12rpx; margin: 0; padding: 12rpx 6rpx; font-size: 36rpx; background: transparent; color: #fff; line-height: 1.4; }.journal-date lp-icon { opacity: .65; }
.journal-search { margin: 24rpx 30rpx; padding: 20rpx; border: 1rpx solid var(--lp-border); border-radius: 14rpx; background: var(--lp-bg-surface); }.journal-search input { font-size: 28rpx; }
.journal-filters { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 20rpx 30rpx; color: var(--lp-brand-text); font-size: 25rpx; }.journal-filters button { margin: 0; padding: 0; background: transparent; font-size: 25rpx; color: inherit; }
.journal-filters picker > view { display: flex; align-items: center; gap: 6rpx; }
.memory-rail { width: 100%; padding: 46rpx 0 10rpx; white-space: nowrap; }
.memory-card { display: inline-block; position: relative; width: 590rpx; height: 318rpx; margin: 0 12rpx 0 30rpx; overflow: hidden; border-radius: 18rpx; vertical-align: top; background: #685550; color: #fff; }.memory-card:last-child { margin-right: 30rpx; }
.memory-cover, .memory-pattern, .memory-shade { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }.memory-cover { filter: blur(10rpx); transform: scale(1.08); }.memory-card.is-revealed .memory-cover { filter: none; }.memory-shade { background: rgba(30, 25, 24, .46); }
.memory-pattern { background: #8a6d61; overflow: hidden; }.memory-pattern view { position: absolute; right: -100rpx; top: -170rpx; width: 420rpx; height: 420rpx; border: 1rpx solid #e7c4aa77; border-radius: 50%; }.memory-pattern view:last-child { top: 80rpx; right: 230rpx; width: 260rpx; height: 260rpx; }
.memory-copy { position: relative; z-index: 1; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24rpx 32rpx; white-space: normal; text-align: center; }
.memory-label { font-size: 34rpx; font-weight: 500; letter-spacing: 5rpx; }.memory-secret, .memory-empty { display: block; margin: 30rpx 0 20rpx; font-size: 28rpx; }.memory-hint { display: block; font-size: 22rpx; color: #ffffffbb; }.memory-date { margin: 10rpx 0; font-size: 28rpx; font-weight: 300; letter-spacing: 3rpx; }.memory-excerpt { max-width: 100%; font-size: 24rpx; line-height: 1.7; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.memory-copy .memory-open { margin: 14rpx 0 0; padding: 6rpx 20rpx; border: 1rpx solid #ffffff88; border-radius: 24rpx; color: #fff; font-size: 22rpx; line-height: 1.8; background: transparent; }
.journal-streak { margin: 26rpx auto 30rpx; padding: 12rpx 10rpx; background: transparent; font-size: 26rpx; line-height: 1.8; color: var(--lp-text-secondary); }
.active-filter { display: flex; justify-content: space-between; align-items: center; margin: 18rpx 30rpx; font-size: 24rpx; color: var(--lp-text-secondary); }.active-filter button { margin: 0; padding: 0; font-size: 24rpx; color: var(--lp-brand-text); background: transparent; }
.journal-feed { padding: 0 30rpx 0 12rpx; }.feed-row { display: flex; align-items: flex-start; margin-bottom: 24rpx; gap: 16rpx; }.feed-day { flex: none; width: 112rpx; padding-top: 30rpx; text-align: center; color: var(--lp-text-secondary); }.feed-day text { display: block; }.feed-day-number { font-size: 46rpx; font-weight: 300; color: var(--lp-text-primary); line-height: 1.4; }.feed-day-month { margin-top: 12rpx; font-size: 20rpx; }.feed-sync { margin-top: 10rpx; font-size: 18rpx; opacity: .7; }
.feed-card { flex: 1; min-width: 0; padding: 30rpx 28rpx 26rpx; border-radius: 18rpx; background: var(--lp-bg-surface); box-shadow: 0 5rpx 16rpx #2f292808; border: 1rpx solid #eedfd855; }.feed-state { display: block; margin-bottom: 12rpx; color: var(--lp-brand-text); font-size: 20rpx; }.feed-title { display: block; margin-bottom: 20rpx; font-size: 29rpx; font-weight: 600; overflow-wrap: anywhere; }.feed-preview { display: -webkit-box; -webkit-line-clamp: 6; -webkit-box-orient: vertical; overflow: hidden; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 29rpx; line-height: 1.665; }.feed-preview.muted { color: var(--lp-text-secondary); }
.feed-images { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8rpx; margin-top: 24rpx; }.feed-photo { position: relative; }.feed-photo image { display: block; width: 100%; height: 148rpx; border-radius: 9rpx; }.feed-photo-more { position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; background: #2f292877; color: #fff; border-radius: 9rpx; font-size: 34rpx; }.feed-audio { display: block; margin-top: 20rpx; font-size: 23rpx; color: var(--lp-text-secondary); }.feed-card-foot { display: flex; justify-content: space-between; gap: 12rpx; margin-top: 28rpx; font-size: 23rpx; color: var(--lp-text-secondary); }
.journal-compose { position: fixed; bottom: calc(32rpx + env(safe-area-inset-bottom)); right: 30rpx; z-index: 35; display: flex; align-items: center; justify-content: center; width: 110rpx; height: 110rpx; margin: 0; padding: 30rpx; border-radius: 50%; background: var(--lp-brand); box-shadow: 0 8rpx 24rpx #2f292822; }.journal-compose image { width: 100%; height: 100%; filter: brightness(0) invert(1); }
.diary-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 80; background: #2f29285c; }.diary-drawer { position: fixed; top: 0; left: 0; bottom: 0; width: 580rpx; z-index: 81; padding-left: 38rpx; padding-right: 38rpx; background: var(--lp-bg-canvas); overflow-y: auto; }.drawer-title { display: block; font-size: 42rpx; font-weight: 500; }.drawer-count { display: block; margin: 18rpx 0 40rpx; font-size: 25rpx; color: var(--lp-text-secondary); }.diary-drawer button, .journal-more button { margin: 0; padding: 24rpx 0; line-height: 1.8; text-align: left; background: transparent; font-size: 30rpx; color: var(--lp-text-primary); }.drawer-divider { height: 1rpx; margin: 20rpx 0; background: var(--lp-border); }.diary-drawer .drawer-close { color: var(--lp-text-secondary); font-size: 25rpx; }
.journal-more { position: fixed; right: 22rpx; width: 350rpx; padding: 8rpx 26rpx; z-index: 81; border: 1rpx solid var(--lp-border); border-radius: 14rpx; background: var(--lp-bg-surface); }.journal-more button { font-size: 27rpx; }
.memory-date-picker { position: fixed; bottom: 0; left: 0; right: 0; z-index: 81; padding: 30rpx 38rpx calc(24rpx + env(safe-area-inset-bottom)); background: var(--lp-bg-canvas); border-radius: 26rpx 26rpx 0 0; }.memory-date-picker > text { display: block; font-size: 30rpx; margin-bottom: 20rpx; }.memory-date-picker scroll-view { max-height: 45vh; }.memory-date-picker button { margin: 0; padding: 24rpx 0; background: transparent; color: var(--lp-text-primary); font-size: 28rpx; }
