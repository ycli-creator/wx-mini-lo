.records-screen { padding: calc(env(safe-area-inset-top) + 96rpx) 28rpx calc(70rpx + env(safe-area-inset-bottom)); background: #fff; color: #444; }
button::after { border: none; } button[disabled] { opacity: .4; }
.health-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.calendar-heading { margin: 22rpx 8rpx 12rpx; }.calendar-heading > text { flex: 1; font-size: 36rpx; font-weight: 600; line-height: 1.5; }
.quiet-button { display: inline-flex; align-items: center; gap: 8rpx; margin: 0; padding: 10rpx 8rpx; background: transparent; color: #ee737c; font-size: 27rpx; line-height: 1.5; }
.calendar-card { margin-bottom: 18rpx; padding: 0; background: #fff; }
.month-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 15rpx; }.month-title { font-size: 26rpx; color: #929292; }.month-arrow { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 60rpx; margin: 0; padding: 0; background: transparent; color: #ee737c; }
.weekday-row, .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }.weekday-row { margin-bottom: 18rpx; text-align: center; font-size: 27rpx; color: #333; }.weekday-row text:first-child, .weekday-row text:last-child { color: #ee737c; }
.calendar-day { position: relative; display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; margin: 4rpx auto; border-radius: 50%; font-size: 29rpx; color: #4b4b4b; }
.calendar-day.outside { visibility: hidden; pointer-events: none; }.day-number { line-height: 1; }.today-label { position: absolute; bottom: 4rpx; font-size: 15rpx; color: #aaa; }
.phase-actual { color: #fff; background: linear-gradient(150deg, #ff965f, #ff5363); }.phase-predicted { color: #ed8f9f; background: #ffdde3; }.phase-fertile, .phase-ovulation { color: #ce92d0; }
.calendar-day.selected { outline: 1rpx solid #e2a9b7; outline-offset: -1rpx; }.calendar-day.today:not(.phase-actual):not(.phase-predicted) { color: #ce92d0; }
.day-markers { position: absolute; bottom: 0; display: flex; }.day-dot { width: 9rpx; height: 9rpx; border-radius: 50%; }.day-dot.event { background: #e4c8d2; }.day-dot.ovulation { background: #80bde8; }
.calendar-legend { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 18rpx; margin: 22rpx 0 12rpx; font-size: 21rpx; color: #999; }.calendar-legend > view { display: flex; align-items: center; gap: 7rpx; }.legend-dot { width: 17rpx; height: 17rpx; border-radius: 50%; }.legend-dot.actual { background: #ff5e6b; }.legend-dot.predicted { background: #ffd4dd; }.legend-dot.fertile { background: #d999dc; }.legend-dot.ovulation { background: #7dbce9; }
.daily-panel { margin: 24rpx -28rpx 0; padding: 10rpx 40rpx 22rpx; border-top: 10rpx solid #f7f7f7; border-bottom: 10rpx solid #f7f7f7; }
.selected-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; color: #aaa; font-size: 19rpx; }.selected-heading button { margin: 0; padding: 14rpx 0; background: transparent; color: #999; font-size: 21rpx; }.selected-heading > text { white-space: nowrap; }
.quick-row { display: flex; align-items: center; justify-content: space-between; min-height: 128rpx; gap: 12rpx; }.quick-label { display: flex; align-items: center; flex: none; gap: 12rpx; font-size: 28rpx; }.quick-options { display: flex; align-items: center; gap: 0; }.quick-icon { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; width: 88rpx; min-height: 96rpx; margin: 0; padding: 0; color: #cfcfcf; background: transparent; }.quick-icon.chosen { color: #f0b64f; }.option-label { display: block; color: #746b65; font-size: 20rpx; line-height: 30rpx; }.option-count { position: absolute; top: 4rpx; right: 9rpx; color: #b37b18; font-size: 19rpx; }.intimacy-add { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; margin: 0; padding: 0; background: transparent; color: #ccc; border: 1rpx dashed #ccc; border-radius: 50%; }
.record-actions { display: flex; align-items: center; justify-content: space-between; padding-top: 20rpx; }.record-actions .quiet-button { color: #999; font-size: 22rpx; }.record-details { padding: 16rpx 0; }.record-details .health-heading > text { font-size: 27rpx; }
.health-note { display: block; margin: 14rpx 0; color: #999; font-size: 23rpx; line-height: 1.65; }.prediction-note { text-align: center; font-size: 19rpx; color: #aaa; }
.choice-grid { display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); gap: 8rpx; }.choice { margin: 0; padding: 14rpx 4rpx; border-radius: 12rpx; background: #f6f6f6; color: #888; font-size: 23rpx; }.choice.chosen { background: #fff0f1; color: #e86676; }.undo-button { margin: 0; padding: 12rpx 2rpx; background: transparent; color: #999; font-size: 20rpx; }
.intimacy-item { display: flex; align-items: center; justify-content: space-between; margin: 0; padding: 16rpx 0; background: transparent; color: #888; font-size: 25rpx; }
.record-cell { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f4f4f4; }.cell-copy { display: flex; flex-direction: column; gap: 10rpx; }.cell-title { font-size: 27rpx; }.cell-subtitle { color: #aaa; font-size: 21rpx; }
.drawer-backdrop { position: fixed; z-index: 120; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: #0005; }.record-drawer { width: 100%; max-height: 78vh; overflow-y: auto; padding: 25rpx 30rpx calc(env(safe-area-inset-bottom) + 30rpx); background: #fff; border-radius: 26rpx 26rpx 0 0; }.drawer-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }.drawer-title { font-size: 31rpx; }.edit-control { min-height: 80rpx; margin: 16rpx 0; padding: 16rpx 18rpx; background: #f7f7f7; border-radius: 12rpx; font-size: 28rpx; }.drawer-action { margin-top: 20rpx; color: #fff; background: #fb626d; border-radius: 16rpx; font-size: 28rpx; }
@media (max-width: 360px) { .daily-panel { padding-left: 26rpx; padding-right: 26rpx; }.quick-label { gap: 12rpx; font-size: 27rpx; }.quick-options { gap: 2rpx; }.quick-icon { width: 84rpx; } }
