page { background: #fff; }
.statistics-screen { min-height: 100vh; padding-right: 32rpx; padding-left: 32rpx; padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); background: #fff; color: #555; }
button::after { border: none; }.statistics-nav { position: fixed; top: 0; right: 0; left: 0; z-index: 20; background: #fff; }.statistics-nav-row { display: flex; align-items: center; gap: 12rpx; padding: 0 26rpx 26rpx; height: 92rpx; }.back-button, .history-button { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 70rpx; margin: 0; padding: 0; background: transparent; }.back-button { color: #f27880; }.history-button { color: #555; }.statistics-tabs { display: flex; align-items: center; flex: 1; }.statistics-tabs button { position: relative; flex: 1; margin: 0; padding: 12rpx 0 22rpx; background: transparent; color: #999; font-size: 31rpx; line-height: 1.5; }.statistics-tabs button.active { color: #444; }.tab-line { position: absolute; bottom: 3rpx; left: 50%; width: 74rpx; height: 6rpx; transform: translateX(-50%); background: #fc6370; border-radius: 10rpx; }
.summary-card { position: relative; margin: 0 0 44rpx; background: #fff; border-radius: 18rpx; box-shadow: 0 2rpx 25rpx #0000000c; overflow: hidden; }.help-button { position: absolute; top: 22rpx; right: 24rpx; width: 42rpx; height: 42rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; background: transparent; color: #999; }.cycle-totals { display: flex; justify-content: space-between; padding: 60rpx 14rpx; }.cycle-totals > view { flex: 1; text-align: center; }.cycle-totals text { display: block; }.cycle-totals text:first-child { margin-bottom: 22rpx; font-size: 43rpx; font-weight: 400; }.cycle-totals text:last-child { color: #999; font-size: 23rpx; white-space: nowrap; }.ticket-divider { position: relative; margin: 0 50rpx; border-top: 2rpx dashed #f1f1f1; }.ticket-divider::before, .ticket-divider::after { content: ''; position: absolute; top: -19rpx; width: 32rpx; height: 36rpx; background: #fafafa; border-radius: 50%; }.ticket-divider::before { left: -67rpx; }.ticket-divider::after { right: -67rpx; }
.cycle-ratio { display: flex; align-items: center; gap: 16rpx; padding: 52rpx 32rpx 30rpx; font-size: 25rpx; color: #999; }.ratio-track { position: relative; display: flex; justify-content: space-between; flex: 1; height: 63rpx; padding: 14rpx 28rpx; overflow: hidden; background: linear-gradient(100deg,#fda5bb,#ffbaa9); border-radius: 60rpx; color: #fff; }.ratio-track > view { position: absolute; top: 0; left: 0; height: 100%; background: linear-gradient(100deg,#ff6579,#ff9276); }.ratio-track text { position: relative; font-size: 27rpx; }.chart-caption { display: inline-flex; align-items: center; justify-content: center; gap: 7rpx; margin: 0 0 42rpx; padding: 8rpx 32rpx; background: #f7f7f7; color: #999; font-size: 25rpx; border-radius: 40rpx; line-height: 1.4; }
.cycle-chart { position: relative; padding: 10rpx 0 0; }.cycle-reference { position: absolute; top: -17rpx; bottom: 15rpx; right: 10%; border-left: 2rpx dashed #ddd; }.cycle-reference text { position: absolute; top: -27rpx; left: -17rpx; width: 34rpx; height: 34rpx; border: 1rpx solid #ccc; border-radius: 50%; background: #fff; font-size: 19rpx; text-align: center; color: #aaa; }.cycle-chart-row { display: flex; align-items: flex-start; width: 100%; margin: 0 0 38rpx; padding: 0; background: transparent; text-align: left; border-radius: 0; }.cycle-date { width: 103rpx; flex: none; font-size: 25rpx; color: #999; line-height: 36rpx; }.cycle-bars { flex: 1; min-width: 0; }.cycle-track { position: relative; height: 35rpx; background: #fafafa; border-radius: 40rpx; }.cycle-bar { display: flex; align-items: center; justify-content: flex-end; height: 100%; padding-right: 16rpx; border-radius: 40rpx; background: linear-gradient(100deg,#fa8b78,#ffd077); color: white; font-size: 23rpx; line-height: 1; }.cycle-bar.estimated { background: linear-gradient(100deg,#ff5c68,#fa71a5); }.estimated-label { position: absolute; top: 0; right: 16rpx; color: #e18dac; font-size: 23rpx; line-height: 35rpx; }.period-dots { display: flex; flex-wrap: wrap; gap: 6rpx; margin: 11rpx 6rpx 0; }.period-dots view { width: 16rpx; height: 16rpx; border-radius: 50%; background: #ff929b; }
.statistics-empty { display: block; padding: 48rpx 24rpx; text-align: center; font-size: 27rpx; line-height: 1.8; color: #999; }.statistics-note { display: block; margin: 30rpx 10rpx; color: #aaa; font-size: 21rpx; line-height: 1.7; text-align: center; }
.profile-summary { display: flex; align-items: center; justify-content: space-between; padding: 42rpx 44rpx; min-height: 180rpx; }.profile-name { display: block; margin-bottom: 12rpx; font-size: 33rpx; }.secondary { display: block; color: #aaa; font-size: 24rpx; line-height: 1.5; }.profile-avatar { position: relative; flex: none; }.profile-avatar image, .habit-profile image { width: 95rpx; height: 95rpx; border-radius: 50%; }.avatar-mood { position: absolute; right: -6rpx; bottom: -10rpx; border-radius: 50%; background: #fff; }.mood-rings { display: flex; justify-content: space-between; gap: 8rpx; padding: 44rpx 32rpx 24rpx; }.mood-ring-item { position: relative; flex: 1; min-width: 0; text-align: center; }.mood-ring { width: 86rpx; height: 86rpx; margin: 0 auto; padding: 6rpx; border-radius: 50%; }.mood-ring > view { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; border-radius: 50%; background: #fff; }.mood-ring text { font-size: 21rpx; color: #aaa; }.ring-face { position: relative; margin-top: -20rpx; }.ring-label { display: block; margin-top: 5rpx; color: #aaa; font-size: 19rpx; }
.heatmap-heading { display: flex; align-items: center; justify-content: space-between; padding: 0 6rpx 28rpx 50rpx; font-size: 29rpx; }.heatmap-heading picker > view { display: flex; align-items: center; gap: 12rpx; }.heatmap-legend { display: flex; align-items: center; gap: 20rpx; color: #999; font-size: 22rpx; }.heatmap-legend > view { display: flex; align-items: center; gap: 6rpx; }.heatmap-sample { width: 24rpx; height: 24rpx; background: #8ad6f3; border-radius: 7rpx; }.heatmap-sample.period { border: 2rpx solid #46bdbd; background: #fff; }.heatmap { display: flex; align-items: flex-start; gap: 12rpx; margin-right: -32rpx; }.heatmap-weekdays { display: flex; flex-direction: column; justify-content: space-between; width: 40rpx; height: 282rpx; padding-top: 43rpx; font-size: 23rpx; color: #999; }.heatmap-scroll { flex: 1; min-width: 0; width: 0; }.heatmap-columns { display: inline-flex; gap: 5rpx; padding: 0 20rpx 3rpx 0; }.heatmap-week { display: flex; flex-direction: column; gap: 5rpx; width: 33rpx; flex: none; }.heatmap-month { height: 37rpx; white-space: nowrap; font-size: 24rpx; color: #999; }.heatmap-cell { width: 33rpx; height: 33rpx; flex: none; margin: 0; padding: 0; border-radius: 7rpx; }.heatmap-cell.is-period { border: 2rpx solid #46bdbd; }.invisible { visibility: hidden; }
.habit-card { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 42rpx 60rpx; min-height: 219rpx; }.habit-total { display: block; font-size: 55rpx; margin-top: 8rpx; }.habit-total text { margin-left: 12rpx; font-size: 27rpx; }.habit-profile { display: flex; flex-direction: column; align-items: center; gap: 12rpx; }.habit-profile > text { max-width: 240rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 26rpx; }.habit-start { position: absolute; right: 42rpx; bottom: 24rpx; z-index: 1; font-size: 21rpx; }.habit-card-wave { position: absolute; left: -30rpx; bottom: -115rpx; width: 580rpx; height: 170rpx; background: #fff7f8; border-radius: 50%; }.habits-heading { display: flex; align-items: center; justify-content: space-between; margin: 52rpx 8rpx 28rpx; font-size: 27rpx; color: #999; }.habits-heading picker > view { display: flex; align-items: center; gap: 8rpx; }.habit-stat-row { display: flex; align-items: center; gap: 16rpx; min-height: 99rpx; }.habit-stat-label { width: 88rpx; flex: none; font-size: 30rpx; }.habit-marks { flex: 1; min-width: 0; display: grid; grid-template-columns: repeat(7,minmax(0,1fr)); gap: 5rpx; }.habit-marks > view { height: 15rpx; border-radius: 20rpx; background: #f5f5f5; }.habit-stat-count { width: 41rpx; flex: none; text-align: right; font-size: 34rpx; font-weight: 300; }.habit-marks.thirty-days { grid-template-columns: repeat(10,minmax(0,1fr)); row-gap: 6rpx; }.habit-marks.thirty-days > view { height: 9rpx; }
.history-scrim { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 50; display: flex; align-items: flex-end; background: #0005; }.history-panel { width: 100%; padding: 26rpx 30rpx calc(25rpx + env(safe-area-inset-bottom)); border-radius: 24rpx 24rpx 0 0; background: white; }.history-title { display: flex; justify-content: space-between; align-items: center; font-size: 29rpx; margin-bottom: 20rpx; }.history-title button { margin: 0; padding: 12rpx; background: transparent; color: #ee737c; font-size: 25rpx; }.history-panel scroll-view { max-height: 55vh; }.history-row { display: flex; align-items: center; flex-wrap: wrap; gap: 14rpx; width: 100%; padding: 20rpx 0; margin: 0; background: transparent; text-align: left; border-bottom: 1rpx solid #f4f4f4; font-size: 24rpx; line-height: 1.6; }.history-row > text:nth-child(2) { flex: 1; color: #999; }
@media (max-width: 360px) { .cycle-totals text:last-child { font-size: 21rpx; }.mood-rings { padding-left: 18rpx; padding-right: 18rpx; }.mood-ring { width: 79rpx; height: 79rpx; }.habit-stat-label { width: 78rpx; font-size: 27rpx; }.habit-stat-row { gap: 10rpx; } }
