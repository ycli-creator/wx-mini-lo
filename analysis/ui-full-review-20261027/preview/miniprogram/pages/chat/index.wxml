<view class="screen inbox-screen">
  <lp-header title="消息" />
  <lp-page-state wx:if="{{loading || loadError}}" loading="{{loading}}" loading-text="加载中…" error-text="消息加载失败，请重试" bind:retry="refresh" />
  <block wx:else>
    <view class="inbox-primary" hover-class="pressed" bind:tap="openChat">
      <view class="avatar"><lp-icon name="chat" size="36rpx" /></view>
      <view class="message-copy"><view class="message-heading"><text class="message-title">{{bound ? partnerName : '情侣私聊'}}</text></view><text class="message-preview">{{bound ? preview : '未绑定伴侣'}}</text></view>
      <text wx:if="{{unread}}" class="unread-count">{{unread > 99 ? '99+' : unread}}</text><text wx:else class="chevron">›</text>
    </view>
    <view class="section-heading"><text class="section-title">通知</text></view>
    <view wx:if="{{notifications.length}}" class="notification-list">
      <view wx:for="{{notifications}}" wx:key="id" class="notification-row {{item.read ? '' : 'is-unread'}}" data-id="{{item.id}}" hover-class="pressed" bind:tap="openNotification"><lp-icon name="notification" size="32rpx"/><view class="message-copy"><text class="message-title">{{item.title}}</text><text class="message-preview">{{item.body}}</text></view><view wx:if="{{!item.read}}" class="notification-dot"></view><text wx:else class="chevron">›</text></view>
    </view>
    <view class="notification-list">
      <view class="notification-row" hover-class="pressed" bind:tap="openCommunity"><lp-icon name="thumb-up" size="32rpx" /><view class="message-copy"><text class="message-title">互动消息</text></view><text class="chevron">›</text></view>
      <view class="notification-row" hover-class="pressed" bind:tap="openTasks"><lp-icon name="task" size="32rpx" /><view class="message-copy"><text class="message-title">待办与心愿</text></view><text class="chevron">›</text></view>
      <view class="notification-row"><lp-icon name="notification" size="32rpx" /><view class="message-copy"><text class="message-title">官方消息</text></view><text class="status-tag status-todo">{{notificationUnread ? notificationUnread + ' 条' : '暂无'}}</text></view>
    </view>

  </block>
</view>
